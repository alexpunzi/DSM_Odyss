            public compartirConCliente::Relationer -> CarpetaCliente.compartidoCon (p_oid : OID -> Carpeta, p_clientes_oid : List<OID -> Cliente>) : Void;
            public dejarDeCompartirConCliente::Unrelationer -> CarpetaCliente.compartidoCon (p_oid : OID -> Carpeta, p_clientes_oid : List<OID -> Cliente>) : Void;
        }
    };

    Class Multimedia
    {
        attributes
