            private descripcion: String (1, 1); 
        }
        
        operations
        {

            public crearMultimedia::New (p_tipo : TipoMultimedia, p_nombre : String, p_fechaSubida : Date, p_descripcion : String, p_carpeta_oid : OID -> Carpeta) : Object->Multimedia;
