ConceptualModel DSM_Odyss {
    
    Class Adress
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private pais : String (1, 1);
            private ciudad : String (1, 1);
            private ubicacionExacta : String (1, 1);
            private latitud : Float (1, 1);
            private longitud : Float (1, 1);
        }
        
        operations
        {
            public new::New (p_pais : String, p_ciudad : String, p_ubicacionExacta : String, p_latitud : Float, p_longitud : Float) : Object->Adress;
            public destroy::Destroy (p_oid : OID -> Adress) : Void;
            public modify::Modifier (p_oid : OID -> Adress, p_pais : String, p_ciudad : String, p_ubicacionExacta : String, p_latitud : Float, p_longitud : Float) : Void;
            public readOID::ReadOID (p_oid : OID -> Adress) : Object->Adress;
            public readAll::ReadAll () : List<Object->Adress>;
        }
    };

    Enumeration MediaType
    {
        (VIDEO, 1), (FOTO, 2)
    };
}
