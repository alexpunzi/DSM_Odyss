            public leerTodosChecklists::ReadAll () : List<Object->Checklist>;

            public conTareas::ReadFilter () : List<Object->Checklist>
            {
                filterLinQ = "entity => entity.Tareas.Any()"
            };

            public vaciarChecklist::CustomTransaction (p_oid : OID -> Checklist) : Void;
            public agregarTarea::Relationer -> ChecklistTarea.tareas (p_oid : OID -> Checklist, p_tareas_oid : List<OID -> Tarea>) : Void;
            public asignarCliente::Relationer -> ChecklistCliente.propietarios (p_oid : OID -> Checklist, p_clientes_oid : List<OID -> Cliente>) : Void;
        }
    };

