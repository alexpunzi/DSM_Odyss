    Class Resena
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private comentario: String; 
            private fecha: Date (1, 1); 
            private puntuacion: Integer (1, 1); 
        }
        
        operations
        {

            public crearResena::New (p_comentario : String, p_fecha : Date, p_puntuacion : Integer, p_viaje_oid : OID -> Viaje, p_cliente_oid : OID -> Cliente) : Object->Resena;
            public borrarResena::Destroy (p_oid : OID -> Resena) : Void;
            public modificarResena::Modifier (p_oid : OID -> Resena, p_comentario : String, p_fecha : Date, p_puntuacion : Integer, p_viaje_oid : OID -> Viaje, p_cliente_oid : OID -> Cliente) : Void;
            public leerResenaOID::ReadOID (p_oid : OID -> Resena) : Object->Resena;
            public leerTodasResenas::ReadAll () : List<Object->Resena>;

            public conPuntuacionMinima::ReadFilter (p_puntuacion : Integer) : List<Object->Resena>
            {
                filterLinQ = "entity => entity.Puntuacion >= p_puntuacion"
            };
        }
    };


    //RELACIONES
    Association ViajeParada (Viaje - ParadaActividad)
    {
        => navigable paradas (0, *);
        <= navigable viaje (1, 1);
    };

    Association ParadaUbicacion (ParadaActividad - Ubicacion)
    {
        => navigable ubicacion (0, 1);
        <= parada (0, *);
    };

    Association ViajeParadaDestino (Viaje - ParadaDestino)
    {
        => navigable paradasDestino (0, *);
        <= navigable viaje (1, 1);
    };

    Association ParadaDestinoDestino (ParadaDestino - Destino)
    {
        => navigable destino (1, 1);
        <= paradas (0, *);
    };

    Association ParadaDestinoActividad (ParadaDestino - ParadaActividad)
    {
        => navigable actividades (0, *);
        <= navigable paradaDestino (0, 1);
    };

    Association ClienteContactos (Cliente - Cliente)
    {
        => navigable contactos (0, *);
        <= navigable contactosInversos (0, *);
    };

    Association ClienteEstadisticas (Cliente - Estadisticas)
    {
        => navigable estadisticas (0, *);
        <= clienteEstadisticas (1, 1);
    };

    Association ClienteViaje (Cliente - Viaje)
    {
        => navigable viajes (0, *);
        <= autor (1, 1);
    };

    Association ViajeCliente (Viaje - Cliente)
    {
        => navigable compartidoCon (0, *);
        <= participante (0, *);
    };

    Association ViajeResena (Viaje - Resena)
    {
        => navigable resenas (0, *);
        <= viaje (1, 1);
    };

    Association ClienteResena (Cliente - Resena)
    {
        => navigable resenas (0, *);
        <= autorResena (1, 1);
    };

    Association ViajeCarpeta (Viaje - Carpeta)
    {
        => navigable carpetas (0, 1);
        <= viaje (1, 1);
    };

    Association ViajeCollage (Viaje - Collage)
    {
        => navigable collages (0, 1);
        <= viaje (1, 1);
    };

    Association CarpetaCliente (Carpeta - Cliente)
    {
        => navigable compartidoCon (0, *);
        <= navigable carpetasCompartidas (0, *);
    };

    Association CarpetaMultimedia (Carpeta - Multimedia)
    {
        => navigable multimedia (0, *);
        <= carpeta (1, 1);
    };

    Association ChecklistCliente (Checklist - Cliente)
    {
        => navigable propietarios (0, *);
        <= propietarioChecklist (1, 1);
    };

    Association ChecklistTarea (Checklist - Tarea)
    {
        => navigable tareas (0, *);
        <= checklist (1, 1);
    };

    Association RecordatorioCliente (Recordatorio - Cliente)
    {
        => navigable recordatorios (0, *);
        <= destinatarioRecordatorio (1, 1);
    };

    Association RecordatorioTarea (Recordatorio - Tarea)
    {
        => navigable tarea (0, 1);
        <= recordatorio (0, 1);
    };
    
}