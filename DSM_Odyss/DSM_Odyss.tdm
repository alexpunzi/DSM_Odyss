ConceptualModel DSM_Odyss {

    // Aqui ponemos los valores que usamos en varias clases.
    Enumeration EstadoViaje
    {
        (planificado, 1), (enCurso, 2), (finalizado, 3)
    };

    Enumeration TipoMultimedia
    {
        (foto, 1), (video, 2)
    };

    Enumeration TipoViaje
    {
        (ocio, 1), (trabajo, 2), (familiar, 3), (otro, 4)
    };
    
    Enumeration CanalNotificacion
    {
        (email, 1), (sms, 2)
    };

    Enumeration TipoAviso
    {
        (notificacion, 1), (alarma, 2)
    };

    // Cliente representa a cada persona que usa la aplicacion.
    Class Cliente <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private user : String (1, 1);
            private password : Password (1, 1);
            private nombre : String (1, 1); 
            private apellidos : String (1, 1); 
            private email: String (1, 1); 
            private fechaNacimiento: Date (1, 1); 
            private canalNotificacion : CanalNotificacion (1, 1); 
            private recibirRecordatorios: Boolean (1, 1);
        }
        
        operations
        {

            public crearCliente::New (p_user : String, p_password : Password, p_nombre : String, p_apellidos : String, p_email : String, p_fechaNacimiento : Date, p_canalNotificacion : CanalNotificacion, p_recibirRecordatorios : Boolean, p_checklist_oid : OID -> Checklist, p_recordatorio_oid : OID -> Recordatorio) : Object->Cliente;
            public borrarCliente::Destroy (p_oid : OID -> Cliente) : Void;
            public modificarCliente::Modifier (p_oid : OID -> Cliente, p_user : String, p_password : Password, p_nombre : String, p_apellidos : String, p_email : String, p_fechaNacimiento : Date, p_canalNotificacion : CanalNotificacion, p_recibirRecordatorios : Boolean, p_checklist_oid : OID -> Checklist, p_recordatorio_oid : OID -> Recordatorio) : Void;
            public leerClienteOID::ReadOID (p_oid : OID -> Cliente) : Object->Cliente;
            public leerTodosClientes::ReadAll () : List<Object->Cliente>;
            public login::Login (p_user : String, p_password : Password) : String;

            public conRecordatoriosActivos::ReadFilter () : List<Object->Cliente>
            {
                filterLinQ = "entity => entity.RecibirRecordatorios"
            };

            public conViajesPublicos::ReadFilter () : List<Object->Cliente>
            {
                filterLinQ = "entity => entity.Viajes.Any(viaje => viaje.EsPublico)"
            };

            public agregarContacto::Custom (p_oid : OID -> Cliente, p_contacto_oid : OID -> Cliente, p_alias : String) : Void; 
            public cambiarPassword::Custom (p_oid : OID -> Cliente, p_oldPass : Password, p_newPass : Password) : Boolean;
            public configurarNotificaciones::Custom (p_oid : OID -> Cliente, p_canal : CanalNotificacion, p_recibirRecordatorios : Boolean) : Void; // CU-14
            public agregarContactoRelacion::Relationer -> ClienteContactos.contactos (p_oid : OID -> Cliente, p_contactos_oid : List<OID -> Cliente>) : Void;
            public quitarContactoRelacion::Unrelationer -> ClienteContactos.contactos (p_oid : OID -> Cliente, p_contactos_oid : List<OID -> Cliente>) : Void;
            public agregarEstadisticasRelacion::Relationer -> ClienteEstadisticas.estadisticas (p_oid : OID -> Cliente, p_estadisticas_oid : List<OID -> Estadisticas>) : Void;
            public agregarViajeRelacion::Relationer -> ClienteViaje.viajes (p_oid : OID -> Cliente, p_viajes_oid : List<OID -> Viaje>) : Void;
            public agregarResenaRelacion::Relationer -> ClienteResena.resenas (p_oid : OID -> Cliente, p_resenas_oid : List<OID -> Resena>) : Void;
        }
    };

    // Guardamos un resumen de los viajes y fotos del cliente.
    Class Estadisticas
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private anyo: Integer (0, 1);
            private paisesVisitados: Integer (0, 1); 
            private fotosSubidas: Integer (0, 1); 
            private destinoMasVisitado: String (0, 1); 
        }
        
        operations
        {

            public crearEstadisticas::New (p_cliente_oid : OID -> Cliente) : Object->Estadisticas;
            public borrarEstadisticas::Destroy (p_oid : OID -> Estadisticas) : Void;
            public modificarEstadisticas::Modifier (p_oid : OID -> Estadisticas, p_cliente_oid : OID -> Cliente) : Void;
            public leerEstadisticasOID::ReadOID (p_oid : OID -> Estadisticas) : Object->Estadisticas;
            public leerTodasEstadisticas::ReadAll () : List<Object->Estadisticas>;


            public recalcularEstadisticas::CustomTransaction (p_oid : OID -> Estadisticas) : Void;
            public generarPassportRecap::Custom (p_oid : OID -> Estadisticas, p_anyo : Integer) : String;
            public obtenerPaisesColoreados::Custom (p_oid : OID -> Estadisticas) : List<String>; 

            public delAnyo::ReadFilter (p_anyo : Integer) : List<Object->Estadisticas>
            {
                filterLinQ = "entity => entity.Anyo == p_anyo"
            };
        }
    };

    // Un viaje puede recorrer varios destinos y tener actividades.
    Class Viaje
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private titulo: String (1, 1); 
            private fechaInicio: Date (1, 1); 
            private fechaFin: Date (1, 1); 
            private esPublico : Boolean (1, 1); 
            private presupuesto: Float (1, 1);
            private tipoViaje: TipoViaje (1, 1); 
            private estado: EstadoViaje (1, 1); 
        }
        
        operations
        {

            public crearViaje::New (p_titulo : String, p_fechaInicio : Date, p_fechaFin : Date, p_esPublico : Boolean, p_presupuesto : Float, p_tipoViaje : TipoViaje, p_estado : EstadoViaje, p_autor_oid : OID -> Cliente, p_carpetas_oid : OID -> Carpeta) : Object->Viaje;
            public borrarViaje::Destroy (p_oid : OID -> Viaje) : Void;
            public modificarViaje::Modifier (p_oid : OID -> Viaje, p_titulo : String, p_fechaInicio : Date, p_fechaFin : Date, p_esPublico : Boolean, p_presupuesto : Float, p_tipoViaje : TipoViaje, p_estado : EstadoViaje, p_autor_oid : OID -> Cliente, p_carpetas_oid : OID -> Carpeta) : Void;
            public leerViajeOID::ReadOID (p_oid : OID -> Viaje) : Object->Viaje;
            public leerTodosViajes::ReadAll () : List<Object->Viaje>;

            public viajesPublicos::ReadFilter () : List<Object->Viaje>
            {
                filterLinQ = "entity => entity.EsPublico"
            };

            public viajesPorEstado::ReadFilter (p_estado : EstadoViaje) : List<Object->Viaje>
            {
                filterLinQ = "entity => entity.Estado == p_estado"
            };

            public compartirItinerario::Custom (p_oid : OID -> Viaje, p_destinatario_oid : OID -> Cliente) : Void; 
            public publicarItinerario::Custom (p_oid : OID -> Viaje, p_esPublico : Boolean) : Void; 
            public duplicarItinerario::CustomTransaction (p_oid : OID -> Viaje, p_nuevoTitulo : String) : Object->Viaje;
            public cambiarEstadoViaje::Custom (p_oid : OID -> Viaje, p_nuevoEstado : EstadoViaje) : Void;
            public agregarParada::Relationer -> ViajeParada.paradas (p_oid : OID -> Viaje, p_paradas_oid : List<OID -> ParadaActividad>) : Void;
            public agregarParadaDestino::Relationer -> ViajeParadaDestino.paradasDestino (p_oid : OID -> Viaje, p_paradasDestino_oid : List<OID -> ParadaDestino>) : Void;
            public compartirConCliente::Relationer -> ViajeCliente.compartidoCon (p_oid : OID -> Viaje, p_clientes_oid : List<OID -> Cliente>) : Void;
            public dejarDeCompartirConCliente::Unrelationer -> ViajeCliente.compartidoCon (p_oid : OID -> Viaje, p_clientes_oid : List<OID -> Cliente>) : Void;
            public agregarResena::Relationer -> ViajeResena.resenas (p_oid : OID -> Viaje, p_resenas_oid : List<OID -> Resena>) : Void;
            public asignarCarpeta::Relationer -> ViajeCarpeta.carpetas (p_oid : OID -> Viaje, p_carpeta_oid : OID -> Carpeta) : Void;
            public asignarCollage::Relationer -> ViajeCollage.collages (p_oid : OID -> Viaje, p_collage_oid : OID -> Collage) : Void;
        }
    };

    // Cada parada de destino guarda el lugar y las fechas de esa parte del viaje.
    Class ParadaDestino
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private orden : Integer (1, 1);
            private fechaLlegada : Date (1, 1);
            private fechaSalida : Date (1, 1);
        }

        operations
        {
            public crearParadaDestino::New (p_orden : Integer, p_fechaLlegada : Date, p_fechaSalida : Date, p_viaje_oid : OID -> Viaje, p_destino_oid : OID -> Destino) : Object->ParadaDestino;
            public borrarParadaDestino::Destroy (p_oid : OID -> ParadaDestino) : Void;
            public modificarParadaDestino::Modifier (p_oid : OID -> ParadaDestino, p_orden : Integer, p_fechaLlegada : Date, p_fechaSalida : Date, p_viaje_oid : OID -> Viaje, p_destino_oid : OID -> Destino) : Void;
            public leerParadaDestinoOID::ReadOID (p_oid : OID -> ParadaDestino) : Object->ParadaDestino;
            public leerTodasParadasDestino::ReadAll () : List<Object->ParadaDestino>;

            public porViaje::ReadFilter (p_viaje_oid : OID -> Viaje) : List<Object->ParadaDestino>
            {
                filterLinQ = "entity => entity.Viaje.Id == p_viaje_oid"
            };

            public asignarActividades::Relationer -> ParadaDestinoActividad.actividades (p_oid : OID -> ParadaDestino, p_actividades_oid : List<OID -> ParadaActividad>) : Void;
        }
    };

    // Una actividad es una tarea concreta del itinerario.
    Class ParadaActividad
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1); 
            private dia: Integer (1, 1); 
            private horario: Time (1, 1); 
            private detalles: String (0, 1); 
            private completada: Boolean (1, 1); 
        }
        
        operations
        {

            public crearParadaActividad::New (p_nombre : String, p_dia : Integer, p_horario : Time, p_completada : Boolean, p_viaje_oid : OID -> Viaje) : Object->ParadaActividad;
            public borrarParadaActividad::Destroy (p_oid : OID -> ParadaActividad) : Void;
            public modificarParadaActividad::Modifier (p_oid : OID -> ParadaActividad, p_nombre : String, p_dia : Integer, p_horario : Time, p_completada : Boolean, p_viaje_oid : OID -> Viaje) : Void;
            public leerParadaActividadOID::ReadOID (p_oid : OID -> ParadaActividad) : Object->ParadaActividad;
            public leerTodasParadasActividades::ReadAll () : List<Object->ParadaActividad>;

            public pendientes::ReadFilter () : List<Object->ParadaActividad>
            {
                filterLinQ = "entity => !entity.Completada"
            };

            public marcarActividadCompletada::Custom (p_oid : OID -> ParadaActividad, p_completada : Boolean) : Void;
            public reordenarHorario::Custom (p_oid : OID -> ParadaActividad, p_nuevoDia : Integer, p_nuevoHorario : Time) : Void;
            public asignarUbicacion::Relationer -> ParadaUbicacion.ubicacion (p_oid : OID -> ParadaActividad, p_ubicacion_oid : OID -> Ubicacion) : Void;
            public desasignarUbicacion::Unrelationer -> ParadaUbicacion.ubicacion (p_oid : OID -> ParadaActividad, p_ubicacion_oid : OID -> Ubicacion) : Void;
            public asignarParadaDestino::Relationer -> ParadaDestinoActividad.paradaDestino (p_oid : OID -> ParadaActividad, p_paradaDestino_oid : OID -> ParadaDestino) : Void;
            public desasignarParadaDestino::Unrelationer -> ParadaDestinoActividad.paradaDestino (p_oid : OID -> ParadaActividad, p_paradaDestino_oid : OID -> ParadaDestino) : Void;
        }
    };

    // La ubicacion guarda las coordenadas del sitio.
    Class Ubicacion
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre: String (1, 1); 
            private latitud: Double (1, 1); 
            private longitud: Double (1, 1); 
        }
        
        operations
        {

            public crearUbicacion::New (p_nombre : String, p_latitud : Double, p_longitud : Double) : Object->Ubicacion;
            public borrarUbicacion::Destroy (p_oid : OID -> Ubicacion) : Void;
            public modificarUbicacion::Modifier (p_oid : OID -> Ubicacion, p_nombre : String, p_latitud : Double, p_longitud : Double) : Void;
            public leerUbicacionOID::ReadOID (p_oid : OID -> Ubicacion) : Object->Ubicacion;
            public leerTodasUbicaciones::ReadAll () : List<Object->Ubicacion>;

            public conNombre::ReadFilter (p_nombre : String) : List<Object->Ubicacion>
            {
                filterLinQ = "entity => entity.Nombre.Contains(p_nombre)"
            };

            public consultarUbicacionEnMapa::Custom (p_oid : OID -> Ubicacion) : String; 
        }
    };

    Class Destino
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private pais: String (1, 1);
            private ciudad: String (0, 1); 
        }
        
        operations
        {

            public crearDestino::New (p_pais : String) : Object->Destino;
            public borrarDestino::Destroy (p_oid : OID -> Destino) : Void;
            public modificarDestino::Modifier (p_oid : OID -> Destino, p_pais : String) : Void;
            public leerDestinoOID::ReadOID (p_oid : OID -> Destino) : Object->Destino;
            public leerTodasDestinos::ReadAll () : List<Object->Destino>;

            public porPais::ReadFilter (p_pais : String) : List<Object->Destino>
            {
                filterLinQ = "entity => entity.Pais.Contains(p_pais)"
            };
        }
    };

    Class Carpeta
    {
        attributes
        {
