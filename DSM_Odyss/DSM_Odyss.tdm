            public borrarRecordatorio::Destroy (p_oid : OID -> Recordatorio) : Void;
            public modificarRecordatorio::Modifier (p_oid : OID -> Recordatorio, p_titulo : String, p_detalles : String, p_fecha : Date, p_hora : Time, p_tipoAviso : TipoAviso, p_enviado : Boolean) : Void;
