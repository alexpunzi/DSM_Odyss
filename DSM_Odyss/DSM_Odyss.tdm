ConceptualModel ModeloDeDominio_Odyss {

    // ---- Enumeraciones ----
    Enumeration EstadoViaje
    {
        (planificado, 1), (enCurso, 2), (finalizado, 3)
    };

    Enumeration TipoMultimedia
    {
        (foto, 1), (video, 2)
    };

    Enumeration TipoViaje
    {
        (ocio, 1), (trabajo, 2), (familiar, 3), (otro, 4)
    };
    
    Enumeration CanalNotificacion
    {
        (email, 1), (sms, 2)
    };

    Enumeration TipoAviso
    {
        (notificacion, 1), (alarma, 2)
    };

    // ---- Clases ----
    Class Cliente <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private name : String (1, 1);
            private password : Password (1, 1);
            private nombre : String (1, 1); 
            private apellidos : String (1, 1); 
            private email: String (1, 1); 
            private fechaNacimiento: Date (1, 1); 
            private canalNotificacion : CanalNotificacion (1, 1); 
            private recibirRecordatorios: Boolean (1, 1);
        }
        
        operations
        {
            public new::New (p_name : String, p_password : Password, p_nombre : String, p_apellidos : String, p_email : String, p_fechaNacimiento : Date, p_canalNotificacion : CanalNotificacion, p_recibirRecordatorios : Boolean, p_cliente_oid : OID -> Checklist, p_cliente_oid : OID -> Recordatorio) : Object->Cliente;
            public destroy::Destroy (p_oid : OID -> Cliente) : Void;
            public modify::Modifier (p_oid : OID -> Cliente, p_name : String, p_password : Password, p_nombre : String, p_apellidos : String, p_email : String, p_fechaNacimiento : Date, p_canalNotificacion : CanalNotificacion, p_recibirRecordatorios : Boolean, p_cliente_oid : OID -> Checklist, p_cliente_oid : OID -> Recordatorio) : Void;
            public readOID::ReadOID (p_oid : OID -> Cliente) : Object->Cliente;
            public readAll::ReadAll () : List<Object->Cliente>;
        }
    };

    // Clase para Estadisticas de usuario + Pasport Recap
    Class Estadisticas
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private anyo: Integer (0, 1);
            private paisesVisitados: Integer (0, 1); 
            private fotosSubidas: Integer (0, 1); 
            private destinoMasVisitado: String (0, 1); 
        }
        
        operations
        {
            public new::New (p_cliente_oid : OID -> Cliente) : Object->Estadisticas;
            public destroy::Destroy (p_oid : OID -> Estadisticas) : Void;
            public modify::Modifier (p_oid : OID -> Estadisticas, p_cliente_oid : OID -> Cliente) : Void;
            public readOID::ReadOID (p_oid : OID -> Estadisticas) : Object->Estadisticas;
            public readAll::ReadAll () : List<Object->Estadisticas>;
        }
    };

    Class Viaje
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private titulo: String (1, 1); 
            private fechaInicio: Date (1, 1); 
            private fechaFin: Date (1, 1); 
            private esPublico : Boolean (1, 1); 
            private presupuesto: Float (1, 1);
            private tipoViaje: TipoViaje (1, 1); 
            private estado: EstadoViaje (1, 1); 
        }
        
        operations
        {
            public new::New (p_titulo : String, p_fechaInicio : Date, p_fechaFin : Date, p_esPublico : Boolean, p_presupuesto : Float, p_tipoViaje : TipoViaje, p_estado : EstadoViaje, p_destino_oid : OID -> Destino, p_autor_oid : OID -> Cliente, p_carpetas_oid : OID -> Carpeta) : Object->Viaje;
            public destroy::Destroy (p_oid : OID -> Viaje) : Void;
            public modify::Modifier (p_oid : OID -> Viaje, p_titulo : String, p_fechaInicio : Date, p_fechaFin : Date, p_esPublico : Boolean, p_presupuesto : Float, p_tipoViaje : TipoViaje, p_estado : EstadoViaje, p_destino_oid : OID -> Destino, p_autor_oid : OID -> Cliente, p_carpetas_oid : OID -> Carpeta) : Void;
            public readOID::ReadOID (p_oid : OID -> Viaje) : Object->Viaje;
            public readAll::ReadAll () : List<Object->Viaje>;
        }
    };

    Class ParadaActividad 
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1); 
            private dia: Integer (1, 1); 
            private horario: Time (1, 1); 
            private detalles: String (0, 1); 
            private completada: Boolean (1, 1); 
        }
        
        operations
        {
            public new::New (p_nombre : String, p_dia : Integer, p_horario : Time, p_completada : Boolean, p_viaje_oid : OID -> Viaje) : Object->ParadaActividad;
            public destroy::Destroy (p_oid : OID -> ParadaActividad) : Void;
            public modify::Modifier (p_oid : OID -> ParadaActividad, p_nombre : String, p_dia : Integer, p_horario : Time, p_completada : Boolean, p_viaje_oid : OID -> Viaje) : Void;
            public readOID::ReadOID (p_oid : OID -> ParadaActividad) : Object->ParadaActividad;
            public readAll::ReadAll () : List<Object->ParadaActividad>;
        }
    };

    // Lugar geográfico al que pertenece una parada o actividad.
    Class Ubicacion 
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre: String (1, 1); 
            private latitud: Double (1, 1); 
            private longitud: Double (1, 1); 
        }
        
        operations
        {
            public new::New (p_nombre : String, p_latitud : Double, p_longitud : Double) : Object->Ubicacion;
            public destroy::Destroy (p_oid : OID -> Ubicacion) : Void;
            public modify::Modifier (p_oid : OID -> Ubicacion, p_nombre : String, p_latitud : Double, p_longitud : Double) : Void;
            public readOID::ReadOID (p_oid : OID -> Ubicacion) : Object->Ubicacion;
            public readAll::ReadAll () : List<Object->Ubicacion>;
        }
    };

    // Destino principal de un viaje (Pais, ciudad)
    Class Destino
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private pais: String (1, 1);
            private ciudad: String (0, 1); 
        }
        
        operations
        {
            public new::New (p_pais : String) : Object->Destino;
            public destroy::Destroy (p_oid : OID -> Destino) : Void;
            public modify::Modifier (p_oid : OID -> Destino, p_pais : String) : Void;
            public readOID::ReadOID (p_oid : OID -> Destino) : Object->Destino;
            public readAll::ReadAll () : List<Object->Destino>;
        }
    };

    Class Carpeta
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre: String (1, 1); 
        }
        
        operations
        {
            public new::New (p_nombre : String, p_viaje_oid : OID -> Viaje) : Object->Carpeta;
            public destroy::Destroy (p_oid : OID -> Carpeta) : Void;
            public modify::Modifier (p_oid : OID -> Carpeta, p_nombre : String, p_viaje_oid : OID -> Viaje) : Void;
            public readOID::ReadOID (p_oid : OID -> Carpeta) : Object->Carpeta;
            public readAll::ReadAll () : List<Object->Carpeta>;
        }
    };

    Class Multimedia
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipo: TipoMultimedia (1, 1);
            private nombre: String (1, 1); 
            private fechaSubida: Date (1, 1); 
            private descripcion: String (1, 1); 
        }
        
        operations
        {
            public new::New (p_tipo : TipoMultimedia, p_nombre : String, p_fechaSubida : Date, p_descripcion : String, p_carpeta_oid : OID -> Carpeta) : Object->Multimedia;
            public destroy::Destroy (p_oid : OID -> Multimedia) : Void;
            public modify::Modifier (p_oid : OID -> Multimedia, p_tipo : TipoMultimedia, p_nombre : String, p_fechaSubida : Date, p_descripcion : String, p_carpeta_oid : OID -> Carpeta) : Void;
            public readOID::ReadOID (p_oid : OID -> Multimedia) : Object->Multimedia;
            public readAll::ReadAll () : List<Object->Multimedia>;
        }
    };

    Class Collage
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private urlImagen: String; 
            private fechaCreacion: Date; 
        }
        
        operations
        {
            public new::New (p_urlImagen : String, p_fechaCreacion : Date, p_viaje_oid : OID -> Viaje) : Object->Collage;
            public destroy::Destroy (p_oid : OID -> Collage) : Void;
            public modify::Modifier (p_oid : OID -> Collage, p_urlImagen : String, p_fechaCreacion : Date, p_viaje_oid : OID -> Viaje) : Void;
            public readOID::ReadOID (p_oid : OID -> Collage) : Object->Collage;
            public readAll::ReadAll () : List<Object->Collage>;
        }
    };

    Class Recordatorio
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private titulo: String (1, 1); 
            private detalles: String; 
            private fecha: Date (1, 1); 
            private hora: Time (1, 1); 
            private tipoAviso: TipoAviso (1, 1); 
            private enviado: Boolean (1, 1); 
        }
        
        operations
        {
            public new::New (p_titulo : String, p_detalles : String, p_fecha : Date, p_hora : Time, p_tipoAviso : TipoAviso, p_enviado : Boolean) : Object->Recordatorio;
            public destroy::Destroy (p_oid : OID -> Recordatorio) : Void;
            public modify::Modifier (p_oid : OID -> Recordatorio, p_titulo : String, p_detalles : String, p_fecha : Date, p_hora : Time, p_tipoAviso : TipoAviso, p_enviado : Boolean) : Void;
            public readOID::ReadOID (p_oid : OID -> Recordatorio) : Object->Recordatorio;
            public readAll::ReadAll () : List<Object->Recordatorio>;
        }
    };

    Class Checklist <AggregateRoot>
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre: String; 
             
        }
        
        operations
        {
            public new::New (p_nombre : String) : Object->Checklist;
            public destroy::Destroy (p_oid : OID -> Checklist) : Void;
            public modify::Modifier (p_oid : OID -> Checklist, p_nombre : String) : Void;
            public readOID::ReadOID (p_oid : OID -> Checklist) : Object->Checklist;
            public readAll::ReadAll () : List<Object->Checklist>;
        }
    };

    
    Class Tarea
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private descripcion: String; 
            private completada: Boolean (1, 1); 
        }
        
        operations
        {
            public new::New (p_descripcion : String, p_completada : Boolean, p_checklist_oid : OID -> Checklist) : Object->Tarea;
            public destroy::Destroy (p_oid : OID -> Tarea) : Void;
            public modify::Modifier (p_oid : OID -> Tarea, p_descripcion : String, p_completada : Boolean, p_checklist_oid : OID -> Checklist) : Void;
            public readOID::ReadOID (p_oid : OID -> Tarea) : Object->Tarea;
            public readAll::ReadAll () : List<Object->Tarea>;
        }
    };

    Class Resena
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private comentario: String; 
            private fecha: Date (1, 1); 
            private puntuacion: Integer (1, 1); 
        }
        
        operations
        {
            public new::New (p_comentario : String, p_fecha : Date, p_puntuacion : Integer, p_viaje_oid : OID -> Viaje, p_cliente_oid : OID -> Cliente) : Object->Resena;
            public destroy::Destroy (p_oid : OID -> Resena) : Void;
            public modify::Modifier (p_oid : OID -> Resena, p_comentario : String, p_fecha : Date, p_puntuacion : Integer, p_viaje_oid : OID -> Viaje, p_cliente_oid : OID -> Cliente) : Void;
            public readOID::ReadOID (p_oid : OID -> Resena) : Object->Resena;
            public readAll::ReadAll () : List<Object->Resena>;
        }
    };


    // ---- Relaciones ----
    Association ViajeParada (Viaje - ParadaActividad)
    {
        => navigable paradas (0, *);
        <= viaje (1, 1);
    };

    Association ParadaUbicacion (ParadaActividad - Ubicacion)
    {
        => navigable ubicacion (0, 1);
        <= parada (0, *);
    };

    Association ViajeDestino (Viaje - Destino)
    {
        => navigable destino (1, 1);
        <= viaje (0, *);
    };

    Association ClienteContactos (Cliente - Cliente)
    {
        => navigable contactos (0, *);
        <= navigable contactosInversos (0, *);
    };
    

    Association ClienteEstadisticas (Cliente - Estadisticas)
    {
        => navigable estadisticas (0, *);
        <= cliente (1, 1);
    };

    Association ClienteViaje (Cliente - Viaje)
    {
        => navigable viajes (0, *);
        <= navigable autor (1, 1);
    };

    Association ViajeCliente (Viaje - Cliente)
    {
        => navigable compartidoCon (0, *);
        <= cliente (0, *);
    };

    Association ViajeResena (Viaje - Resena)
    {
        => navigable resenas (0, *);
        <= viaje (1, 1);
    };

    Association ClienteResena (Cliente - Resena)
    {
        => navigable resenas (0, *);
        <= cliente (1, 1);
    };

    Association ViajeCarpeta (Viaje - Carpeta)
    {
        => navigable carpetas (0, 1);
        <= viaje (1, 1);
    };

    Association ViajeCollage (Viaje - Collage)
    {
        => navigable collages (0, 1);
        <= viaje (1, 1);
    };

    Association CarpetaMultimedia (Carpeta - Multimedia)
    {
        => navigable multimedia (0, *);
        <= carpeta (1, 1);
    };

    Association ChecklistCliente (Checklist - Cliente)
    {
        => navigable checklist (0, *);
        <= cliente (1, 1);
    };

    Association ChecklistTarea (Checklist - Tarea)
    {
        => navigable tareas (0, *);
        <= checklist (1, 1);
    };

    Association RecordatorioCliente (Recordatorio - Cliente)
    {
        => navigable recordatorios (0, *);
        <= cliente (1, 1);
    };

    Association RecordatorioTarea (Recordatorio - Tarea)
    {
        => navigable tarea (0, 1);
        <= recordatorio (0, 1);
    };
    
}