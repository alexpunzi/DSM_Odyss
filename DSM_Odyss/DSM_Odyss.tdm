ConceptualModel ModeloDeDominio_Odyss {

    // ---- Enumeraciones ----
    Enumeration EstadoViaje
    {
        (planificado, 1), (enCurso, 2), (finalizado, 3)
    };

    Enumeration TipoMultimedia
    {
        (foto, 1), (video, 2)
    };

    Enumeration TipoViaje
    {
        (ocio, 1), (trabajo, 2), (familiar, 3), (otro, 4)
    };
    
    Enumeration CanalNotificacion
    {
        (email, 1), (sms, 2)
    };

    Enumeration TipoAviso
    {
        (notificacion, 1), (alarma, 2)
    };

    // ---- Clases ----
    Class Cliente <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private name : String (1, 1);
            private password : Password (1, 1);
            private nombre : String (1, 1); 
            private apellidos : String (1, 1); 
            private email: String (1, 1); 
            private fechaNacimiento: Date (1, 1); 
            private canalNotificacion : CanalNotificacion (1, 1); 
            private recibirRecordatorios: Boolean (1, 1);
        }
        
        operations
        {
            
        }
    };

    // Clase para Estadisticas de usuario + Pasport Recap
    Class Estadisticas
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private anyo: Integer (0, 1);
            private paisesVisitados: Integer (0, 1); 
            private fotosSubidas: Integer (0, 1); 
            private destinoMasVisitado: String (0, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Viaje
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private titulo: String (1, 1); 
            private fechaInicio: Date (1, 1); 
            private fechaFin: Date (1, 1); 
            private esPublico : Boolean (1, 1); 
            private presupuesto: Float (1, 1);
            private tipoViaje: TipoViaje (1, 1); 
            private estado: EstadoViaje (1, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Parada 
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1); 
            private dia: Integer (1, 1); 
            private horario: Time (1, 1); 
            private detalles: String (1, 1); 
            private completada: Boolean (1, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Carpeta
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre: String (1, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Multimedia
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipo: TipoMultimedia (1, 1);
            private nombre: String (1, 1); 
            private fechaSubida: Date (1, 1); 
            private descripcion: String (1, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Collage
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private urlImagen: String; 
            private fechaCreacion: Date; 
        }
        
        operations
        {
            
        }
    };

    // Lugar geográfico o país al que pertenece el viaje o parada.
    Class Ubicacion 
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre: String (1, 1); 
            private ciudad: String (1, 1); 
            private latitud: Double (1, 1); 
            private longitud: Double (1, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Recordatorio
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private titulo: String (1, 1); 
            private detalles: String; 
            private fecha: Date (1, 1); 
            private hora: Time (1, 1); 
            private tipoAviso: TipoAviso (1, 1); 
            private enviado: Boolean (1, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Checklist <AggregateRoot>
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre: String; 
             
        }
        
        operations
        {
            
        }
    };

    
    Class Tarea
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private descripcion: String; 
            private completada: Boolean (1, 1); 
        }
        
        operations
        {
            
        }
    };

    Class Reseña
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private comentario: String; 
            private fecha: Date (1, 1); 
            private puntuacion: Integer (1, 1); 
        }
        
        operations
        {
            
        }
    };


    // ---- Relaciones ----
    Association ParadaUbicacion (Parada - Ubicacion)
    {
        => navigable ubicacion (0, 1);
        <= parada (0, *);
    };

    Association ViajeParada (Viaje - Parada)
    {
        => navigable paradas (0, *);
        <= viaje (1, 1);
    };

    Association ClienteContactos (Cliente - Cliente)
    {
        => navigable contactos (0, *);
        <= navigablecontactos (0, *);
    };

    Association ClienteEstadisticas (Cliente - Estadisticas)
    {
        => navigable estadisticas (0, *);
        <= cliente (1, 1);
    };

    Association ClienteViaje (Cliente - Viaje)
    {
        => navigable viajes (0, *);
        <= navigable autor (1, 1);
    };

    Association ViajeCliente (Viaje - Cliente)
    {
        => navigable compartidoCon (0, *);
        <= cliente (0, *);
    };

    Association ViajeReseña (Viaje - Reseña)
    {
        => navigable reseñas (0, *);
        <= viaje (1, 1);
    };

    Association ClienteReseña (Cliente - Reseña)
    {
        => navigable reseñas (0, *);
        <= cliente (1, 1);
    };

    Association ViajeCarpeta (Viaje - Carpeta)
    {
        => navigable carpetas (1, 1);
        <= viaje (1, 1);
    };

    Association ViajeCollage (Viaje - Collage)
    {
        => navigable collages (0, 1);
        <= viaje (1, 1);
    };

    Association CarpetaMultimedia (Carpeta - Multimedia)
    {
        => navigable multimedia (0, *);
        <= carpeta (1, 1);
    };

    Association ChecklistCliente (Checklist - Cliente)
    {
        => navigable checklist (0, *);
        <= cliente (1, 1);
    };

    Association ChecklistTarea (Checklist - Tarea)
    {
        => navigable tareas (0, *);
        <= checklist (1, 1);
    };

    Association RecordatorioCliente (Recordatorio - Cliente)
    {
        => navigable recordatorios (0, *);
        <= cliente (1, 1);
    };

    Association RecordatorioTarea (Recordatorio - Tarea)
    {
        => navigable tarea (0, 1);
        <= recordatorio (0, 1);
    };
    
}