@model DSM_Odyss.Web.ViewModels.DestinoViewModel

@{
    ViewData["Title"] = "Detalles";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
