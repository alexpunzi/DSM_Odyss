            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Ciudad)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Ciudad)</dd>
                </dl>

            </div>
            <div class="card-footer bg-body p-4">
