@model DSM_Odyss.Web.ViewModels.ConsultaResultadoViewModel<string, DSM_Odyss.Web.ViewModels.DestinoViewModel>

@{
    ViewData["Title"] = "Destinos por país";
}

<div class="container py-2" style="max-width: 550px;">
    <h2 class="h4 fw-semibold mb-3"><i class="bi bi-geo-alt me-2"></i>Destinos por país</h2>

    <form asp-action="PorPais" method="get" class="card card-body border-0 shadow-sm rounded-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col">
                <label for="p_pais" class="form-label small fw-semibold mb-1">País</label>
                <input id="p_pais" name="p_pais" type="text" class="form-control form-control-sm" value="@Model.Parametro" placeholder="Ej. España, Japón..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>
            </div>
        </div>
    </form>

    @if (string.IsNullOrWhiteSpace(Model.Parametro))
    {
        <div class="alert alert-light border text-muted text-center">Introduce un país para buscar destinos.</div>
    }
    else if (!Model.Resultados.Any())
    {
        <div class="alert alert-light border text-muted text-center">No se encontraron destinos para "@Model.Parametro".</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>País</th>
                        <th>Ciudad</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Resultados)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Pais</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Ciudad) ? "-" : item.Ciudad)</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
