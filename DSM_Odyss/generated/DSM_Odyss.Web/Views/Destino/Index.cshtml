@model IEnumerable<DSM_Odyss.Web.ViewModels.DestinoViewModel>

@{
    ViewData["Title"] = "Mi mapa desbloqueado";
}

<div class="container py-2" style="max-width: 550px;">

    @await Component.InvokeAsync("PerfilCabecera", new { pestana = "mapa" })

    <section class="mt-4" aria-labelledby="mapa-destinos-titulo">
        <h1 id="mapa-destinos-titulo" class="h4 fw-semibold mb-1">Mi mapa de viajes</h1>
        <p class="text-muted small mb-3">Los países de tus destinos se marcan en negro.</p>

        @if (!Model.Any())
        {
            <p class="text-muted small">Aún no tienes países en tus viajes. Cuando añadas destinos, aparecerán aquí.</p>
        }

        <div class="destination-map-widget" data-destination-map="profile" data-country-map-url="@Url.Content("~/data/world-countries.geojson")">
            <div class="destination-map-canvas rounded-3 border" role="application" aria-label="Mapa mundial con los países de tus viajes marcados"></div>
            <p class="destination-map-status small text-muted mt-2 mb-0" aria-live="polite">Cargando mapa de países...</p>
        </div>

        @if (Model.Any())
        {
            <div class="d-flex align-items-center gap-2 small mt-3">
                <span class="country-map-legend-swatch" aria-hidden="true"></span>
                <span>Países de tus destinos</span>
            </div>
            <ul class="visually-hidden" data-map-countries>
                @foreach (var destino in Model)
                {
                    <li data-country="@destino.Pais"></li>
                }
            </ul>

            <div class="d-flex flex-wrap gap-2 mt-3" aria-label="Países de tus viajes">
                @foreach (var destino in Model)
                {
                    <span class="badge rounded-pill text-bg-dark">@destino.Pais</span>
                }
            </div>
        }
        <p class="small text-muted mt-3 mb-0">Mapa vectorial de países: Natural Earth.</p>
    </section>

</div>

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />
<style>
    .destination-map-canvas { height: 360px; min-height: 260px; background: #fff; }
    .country-map-legend-swatch { display: inline-block; width: 14px; height: 14px; background: #111; border: 1px solid #111; }
</style>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/destination-map.js" asp-append-version="true"></script>
}