@* Barra de navegación del perfil (M08–M18). Se pasa como modelo la pestaña activa:
   "galeria", "mapa", "itinerarios" o "estadisticas". *@
@model string

@{
    string Clase(string pestana) => pestana == Model
        ? "btn btn-dark rounded-pill px-3 py-1 btn-sm fw-semibold flex-shrink-0 text-nowrap"
        : "btn btn-outline-secondary rounded-pill px-3 py-1 btn-sm flex-shrink-0 text-nowrap";
}

<nav class="d-flex gap-2 overflow-auto pb-2 mb-4" style="scrollbar-width: none;" aria-label="Secciones del perfil">
    <a asp-controller="Cliente" asp-action="Details" class="@Clase("galeria")">
        <i class="bi bi-eye me-1"></i> Mi perfil
    </a>
    <a asp-controller="Destino" asp-action="Index" class="@Clase("mapa")">
        <i class="bi bi-map me-1"></i> Mi mapa desbloqueado
    </a>
    <a asp-controller="Viaje" asp-action="Index" class="@Clase("itinerarios")">
        <i class="bi bi-lock me-1"></i> Mis viajes privados
    </a>
    <a asp-controller="Estadisticas" asp-action="Index" class="@Clase("estadisticas")">
        <i class="bi bi-bar-chart-line me-1"></i> Mis estadísticas
    </a>
</nav>