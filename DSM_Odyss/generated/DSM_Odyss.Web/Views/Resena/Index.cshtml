@model List<DSM_Odyss.Web.ViewModels.PerfilResenaItem>

@{
    ViewData["Title"] = "Mis reseñas";
}

<style>
    .imagen-vacia {
        background: #f1f3f5;
        display: flex; align-items: center; justify-content: center;
        color: #adb5bd;
    }
    .tarjeta-enlace { color: inherit; text-decoration: none; transition: background .15s; }
    .tarjeta-enlace:hover { background: #f8f9fa; }
    .comentario-corto {
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container py-2" style="max-width: 550px;">

    @* Cabecera sin pestañas: el botón de volver lleva a Mi perfil *@
    @await Component.InvokeAsync("PerfilCabecera")

    <h2 class="h4 fw-semibold mb-3">Mis reseñas</h2>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-star fs-1 d-block mb-2"></i>
            <p class="mb-0">Todavía no has escrito ninguna reseña.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var resena in Model)
            {
                <a asp-controller="Resena" asp-action="Details" asp-route-id="@resena.Id"
                   class="tarjeta-enlace d-flex align-items-start gap-3 border rounded-3 p-2">
                    <div class="imagen-vacia rounded-circle flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-airplane fs-5"></i>
                    </div>
                    <div class="flex-grow-1" style="min-width: 0;">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="fw-semibold small text-truncate">@resena.TituloViaje</div>
                            <div class="text-muted text-nowrap" style="font-size: .75rem;">@resena.FechaViaje.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="text-warning small" title="@resena.Puntuacion de 5">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= resena.Puntuacion ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(resena.Comentario))
                        {
                            <div class="text-muted small comentario-corto mt-1">@resena.Comentario</div>
                        }
                    </div>
                </a>
            }
        </div>
    }

</div>