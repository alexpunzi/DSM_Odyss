@model List<DSM_Odyss.Web.ViewModels.PerfilResenaItem>

@{
    ViewData["Title"] = "Reseñas recibidas";
}

<style>
    .imagen-vacia {
        background: #f1f3f5;
        display: flex; align-items: center; justify-content: center;
        color: #adb5bd;
    }
</style>

<div class="container py-2" style="max-width: 550px;">

    @* Cabecera sin pestañas: el botón de volver lleva a Mi perfil *@
    @await Component.InvokeAsync("PerfilCabecera")

    <h2 class="h4 fw-semibold mb-1">Reseñas recibidas</h2>
    <p class="text-muted small mb-3">Lo que otros viajeros opinan de tus viajes.</p>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-star fs-1 d-block mb-2"></i>
            <p class="mb-0">Tus viajes todavía no han recibido reseñas.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var resena in Model)
            {
                <div class="d-flex align-items-start gap-3 border rounded-3 p-2">
                    <div class="imagen-vacia rounded-circle flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-airplane fs-5"></i>
                    </div>
                    <div class="flex-grow-1" style="min-width: 0;">
                        <div class="d-flex justify-content-between gap-2">
                            <div class="fw-semibold small text-truncate">@resena.TituloViaje</div>
                            <div class="text-muted text-nowrap" style="font-size: .75rem;">@resena.FechaViaje.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="small">
                            <span class="text-warning" title="@resena.Puntuacion de 5">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= resena.Puntuacion ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </span>
                            <span class="text-muted ms-1" style="font-size: .75rem;">por @@@resena.Autor</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(resena.Comentario))
                        {
                            <div class="small mt-1" style="white-space: pre-line;">@resena.Comentario</div>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>