@model DSM_Odyss.Web.ViewModels.CarpetaDetailsViewModel

@{
    ViewData["Title"] = Model.Nombre;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-2" style="max-width: 550px;">

    @* Cabecera común del perfil. Si alguien entra con el enlace público (sin sesión), no se muestra. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("PerfilCabecera")
    }

    @* Barra de la carpeta, como en M17/M18:  <  📁 Nombre   [compartir] [editar] *@
    <div class="d-flex align-items-center gap-2 mb-3">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Carpeta" asp-action="Index" class="btn btn-link text-body p-0 fs-4" aria-label="Volver a mis carpetas">
                <i class="bi bi-chevron-left"></i>
            </a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-link text-body p-0 fs-4" aria-label="Volver al inicio">
                <i class="bi bi-chevron-left"></i>
            </a>
        }

        <i class="bi bi-folder2-open fs-4"></i>

        <div class="flex-grow-1" style="min-width: 0;">
            <h1 class="h5 fw-semibold mb-0 text-truncate">@Model.Nombre</h1>
            <div class="small text-muted text-truncate">@Model.ViajeTitulo</div>
        </div>

        @if (Model.EsPropietario)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-3" id="toggleSharePanel"
                    aria-controls="sharePanel" aria-expanded="@(!string.IsNullOrWhiteSpace(Model.Busqueda))" title="Compartir carpeta">
                <i class="bi bi-share"></i>
            </button>
        }
        @if (Model.PuedeEditar)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-3" title="Editar carpeta">
                <i class="bi bi-pencil"></i>
            </a>
        }
    </div>

    @if (Model.EsEnlacePublico)
    {
        <div class="alert alert-info py-2 small">Estás viendo una carpeta compartida mediante enlace. El acceso es de solo lectura.</div>
    }

    @if (TempData["CarpetaError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (TempData["CarpetaMensaje"] is string mensaje)
    {
        <div class="alert alert-success py-2 small" role="status">@mensaje</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.CollageUrl) || Model.AutoGenerateCollage)
    {
        <section id="tripCollage"
                 class="card border-0 shadow-sm mb-4"
                 data-auto-generate="@Model.AutoGenerateCollage.ToString().ToLowerInvariant()"
                 data-viaje-id="@Model.ViajeId"
                 data-save-url="@Url.Action("GenerarCollageAutomatico", "Collage")"
                 aria-label="Resumen automático del viaje">
            <div class="card-body p-2">
                <h2 class="h6 px-2 pt-1">Resumen del viaje</h2>
                <img id="tripCollageImage"
                     src="@Model.CollageUrl"
                     alt="Collage automático de @Model.ViajeTitulo"
                     class="img-fluid w-100 rounded-3 @(string.IsNullOrWhiteSpace(Model.CollageUrl) ? "d-none" : string.Empty)" />
                <div id="collageStatus" class="small text-body-secondary px-2 py-2" role="status">
                    @(Model.AutoGenerateCollage ? "Creando el collage automáticamente…" : "Collage creado a partir de las fotos del viaje.")
                </div>
            </div>
        </section>
    }

    <section aria-label="Fotos y vídeos de la carpeta">
        @if (Model.Archivos.Count == 0)
        {
            <div class="text-center rounded-4 border bg-body p-5">
                <i class="bi bi-images display-5 text-body-secondary"></i>
                <h2 class="h5 mt-3">Aún no hay recuerdos</h2>
                <p class="text-body-secondary mb-0">Sube fotos o vídeos para empezar la galería de este viaje.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-sm-3 g-2">
                @foreach (var archivo in Model.Archivos)
                {
                    <div class="col">
                        <div class="ratio ratio-1x1 overflow-hidden rounded-3 bg-dark-subtle">
                            @if (!archivo.TieneArchivo)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center text-body-secondary p-3 text-center">
                                    <i class="bi @(archivo.EsVideo ? "bi-camera-video" : "bi-image") fs-2"></i>
                                    <span class="small mt-2">Archivo sin contenido</span>
                                </div>
                            }
                            else if (archivo.EsVideo)
                            {
                                <video src="@archivo.Url" controls preload="metadata" aria-label="@archivo.Nombre"></video>
                            }
                            else
                            {
                                <button type="button" class="btn p-0 border-0 w-100 h-100 js-gallery-item"
                                        data-url="@archivo.Url" data-nombre="@archivo.Nombre"
                                        aria-label="Abrir @archivo.Nombre">
                                    <img src="@archivo.Url" alt="@archivo.Nombre" class="w-100 h-100 object-fit-cover" loading="lazy" data-collage-source="true" />
                                </button>
                            }
                        </div>
                        <div class="small text-truncate mt-1" title="@archivo.Nombre">@archivo.Nombre</div>
                        @if (Model.PuedeEditar && Model.CarpetasDestino.Count > 0)
                        {
                            <form asp-controller="Multimedia" asp-action="MoverDeCarpeta" method="post" class="d-flex gap-1 mt-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="p_oid" value="@archivo.Id" />
                                <input type="hidden" name="carpetaOrigenId" value="@Model.Id" />
                                <select name="p_nuevaCarpeta_oid" class="form-select form-select-sm" aria-label="Mover @archivo.Nombre a otra carpeta">
                                    @foreach (var carpeta in Model.CarpetasDestino)
                                    {
                                        <option value="@carpeta.Value">@carpeta.Text</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Mover a carpeta">
                                    <i class="bi bi-folder-symlink"></i>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </section>

    @if (Model.PuedeEditar)
    {
        <form asp-action="SubirArchivo" method="post" enctype="multipart/form-data" class="border rounded-3 bg-body p-3 mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="carpetaId" value="@Model.Id" />
            <label for="archivo" class="form-label fw-semibold">Añadir foto o vídeo</label>
            <div class="input-group">
                <input id="archivo" name="archivo" type="file" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime" required />
                <button type="submit" class="btn btn-primary">Subir</button>
            </div>
            <div class="form-text">JPG, PNG, GIF, WEBP, MP4, WEBM o MOV. Máximo 25 MB.</div>
        </form>
    }

    @if (Model.EsPropietario)
    {
        <section id="sharePanel" class="card border shadow-sm mt-4 @(string.IsNullOrWhiteSpace(Model.Busqueda) ? "d-none" : string.Empty)" aria-label="Compartir carpeta">
            <div class="card-body p-3 p-sm-4">
                <h2 class="h5 text-center mb-3">Compartir esta carpeta de viaje</h2>

                <form asp-action="Details" asp-route-id="@Model.Id" method="get" class="mb-3">
                    <label for="userSearch" class="form-label visually-hidden">Buscar usuarios</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="userSearch" name="q" value="@Model.Busqueda" class="form-control" placeholder="Buscar por usuario o nombre" minlength="2" />
                        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                    </div>
                </form>

                @if (Model.ResultadosBusqueda.Count > 0)
                {
                    <div class="list-group mb-3">
                        @foreach (var usuario in Model.ResultadosBusqueda)
                        {
                            <form asp-action="ActualizarPermiso" method="post" class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="carpetaId" value="@Model.Id" />
                                <input type="hidden" name="clienteId" value="@usuario.Id" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@@@usuario.Usuario</div>
                                    <div class="small text-body-secondary">@usuario.NombreCompleto</div>
                                </div>
                                <select name="puedeEditar" class="form-select form-select-sm" style="width:auto" aria-label="Permiso para @usuario.Usuario">
                                    <option value="false">Solo ver</option>
                                    <option value="true">Editar</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">Compartir</button>
                            </form>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.Busqueda))
                {
                    <p class="small text-body-secondary">No se encontraron usuarios para esa búsqueda.</p>
                }

                @if (Model.Compartidos.Count > 0)
                {
                    <h3 class="h6 mt-3">Personas con acceso</h3>
                    <div class="list-group mb-4">
                        @foreach (var compartido in Model.Compartidos)
                        {
                            <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                <i class="bi bi-person-circle"></i>
                                <span class="flex-grow-1">@@@compartido.Usuario</span>
                                <form asp-action="ActualizarPermiso" method="post" class="d-flex align-items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="carpetaId" value="@Model.Id" />
                                    <input type="hidden" name="clienteId" value="@compartido.Id" />
                                    <select name="puedeEditar" class="form-select form-select-sm" aria-label="Cambiar permiso de @compartido.Usuario">
                                        <option value="false" selected="@(!compartido.PuedeEditar)">Solo ver</option>
                                        <option value="true" selected="@compartido.PuedeEditar">Editar</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                                </form>
                                <form asp-action="QuitarCompartido" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="carpetaId" value="@Model.Id" />
                                    <input type="hidden" name="clienteId" value="@compartido.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Quitar a @compartido.Usuario">
                                        <i class="bi bi-person-x"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }

                <hr />
                <h3 class="h6 text-center">O copia un enlace público de solo lectura</h3>
                <div class="input-group">
                    <input id="shareUrl" type="url" class="form-control" value="@Model.EnlacePublico" readonly aria-label="Enlace público de la carpeta" />
                    <button id="copyShareUrl" class="btn btn-outline-primary" type="button">
                        <i class="bi bi-copy me-1"></i>Copiar
                    </button>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span id="copyStatus" class="small text-body-secondary" role="status">Cualquiera con el enlace podrá ver la galería.</span>
                    <form asp-action="RevocarEnlace" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="carpetaId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-link text-danger">Generar otro enlace</button>
                    </form>
                </div>
                <div class="text-center mt-3">
                    <button id="nativeShare" type="button" class="btn btn-link text-body-secondary" aria-label="Compartir enlace">
                        <i class="bi bi-send fs-5"></i>
                    </button>
                </div>
            </div>
        </section>
    }
</div>

<div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title h6 text-truncate" id="galleryModalTitle">Foto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center bg-dark p-2">
                <img id="galleryModalImg" src="" alt="" class="img-fluid rounded-2" style="max-height: 70vh; object-fit: contain;" />
            </div>
            <div class="modal-footer justify-content-between py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="galleryPrev">
                    <i class="bi bi-chevron-left me-1"></i>Anterior
                </button>
                <span class="small text-muted" id="galleryCounter"></span>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="galleryNext">
                    Siguiente<i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const collagePanel = document.getElementById("tripCollage");
            if (collagePanel && collagePanel.dataset.autoGenerate === "true") {
                const status = document.getElementById("collageStatus");
                const collageImage = document.getElementById("tripCollageImage");
                const imageSources = Array.from(document.querySelectorAll('img[data-collage-source]')).slice(0, 6);

                const loadImage = (source) => new Promise((resolve, reject) => {
                    const image = new Image();
                    image.onload = () => resolve(image);
                    image.onerror = () => reject(new Error("No se pudo cargar una de las fotos."));
                    image.src = source;
                });

                const drawCover = (context, image, x, y, width, height) => {
                    const scale = Math.max(width / image.naturalWidth, height / image.naturalHeight);
                    const drawnWidth = image.naturalWidth * scale;
                    const drawnHeight = image.naturalHeight * scale;
                    context.drawImage(
                        image,
                        x + (width - drawnWidth) / 2,
                        y + (height - drawnHeight) / 2,
                        drawnWidth,
                        drawnHeight);
                };

                if (imageSources.length > 0) {
                    (async () => {
                        try {
                            const images = await Promise.all(imageSources.map(item => loadImage(item.src)));
                            const canvas = document.createElement("canvas");
                            canvas.width = 1200;
                            canvas.height = 800;
                            const context = canvas.getContext("2d");
                            if (!context) throw new Error("No se pudo preparar el collage.");

                            const columns = Math.min(3, images.length);
                            const rows = Math.ceil(images.length / columns);
                            const cellWidth = canvas.width / columns;
                            const cellHeight = canvas.height / rows;
                            images.forEach((image, index) => {
                                drawCover(context, image, (index % columns) * cellWidth, Math.floor(index / columns) * cellHeight, cellWidth, cellHeight);
                            });

                            const imageDataUrl = canvas.toDataURL("image/jpeg", 0.82);
                            collageImage.src = imageDataUrl;
                            collageImage.classList.remove("d-none");

                            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                            if (!antiForgeryToken) throw new Error("No se pudo validar la sesión para guardar el collage.");

                            const response = await fetch(collagePanel.dataset.saveUrl, {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                                    "RequestVerificationToken": antiForgeryToken
                                },
                                body: new URLSearchParams({
                                    p_viaje_oid: collagePanel.dataset.viajeId,
                                    imagenDataUrl: imageDataUrl
                                })
                            });
                            if (!response.ok) throw new Error("El collage se creó, pero no se pudo guardar.");
                            status.textContent = "Collage generado y guardado automáticamente.";
                        } catch (error) {
                            status.textContent = error instanceof Error ? error.message : "No se pudo generar el collage.";
                        }
                    })();
                }
            }

            const toggle = document.getElementById("toggleSharePanel");
            const panel = document.getElementById("sharePanel");
            if (toggle && panel) {
                toggle.addEventListener("click", () => {
                    const isHidden = panel.classList.toggle("d-none");
                    toggle.setAttribute("aria-expanded", String(!isHidden));
                });
            }

            const urlInput = document.getElementById("shareUrl");
            const copyButton = document.getElementById("copyShareUrl");
            const status = document.getElementById("copyStatus");
            if (urlInput && copyButton && status) {
                copyButton.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(urlInput.value);
                        status.textContent = "Enlace copiado.";
                    } catch {
                        urlInput.select();
                        status.textContent = "Copia el enlace seleccionado.";
                    }
                });
            }

            const shareButton = document.getElementById("nativeShare");
            if (shareButton && urlInput) {
                shareButton.addEventListener("click", async () => {
                    if (navigator.share) {
                        try {
                            await navigator.share({ title: document.title, url: urlInput.value });
                        } catch {
                            if (status) status.textContent = "No se pudo abrir el menú para compartir.";
                        }
                    } else if (copyButton) {
                        copyButton.click();
                    }
                });
            }

            const galleryItems = Array.from(document.querySelectorAll(".js-gallery-item"));
            const galleryModalEl = document.getElementById("galleryModal");
            if (galleryItems.length > 0 && galleryModalEl) {
                const modalImg = document.getElementById("galleryModalImg");
                const modalTitle = document.getElementById("galleryModalTitle");
                const modalCounter = document.getElementById("galleryCounter");
                const prevBtn = document.getElementById("galleryPrev");
                const nextBtn = document.getElementById("galleryNext");
                let currentIndex = 0;

                const showPhoto = (index) => {
                    currentIndex = (index + galleryItems.length) % galleryItems.length;
                    const item = galleryItems[currentIndex];
                    modalImg.src = item.dataset.url || "";
                    modalImg.alt = item.dataset.nombre || "";
                    modalTitle.textContent = item.dataset.nombre || "Foto";
                    modalCounter.textContent = `${currentIndex + 1} / ${galleryItems.length}`;
                    const single = galleryItems.length <= 1;
                    prevBtn.disabled = single;
                    nextBtn.disabled = single;
                };

                galleryItems.forEach((btn, idx) => {
                    btn.addEventListener("click", () => {
                        showPhoto(idx);
                        bootstrap.Modal.getOrCreateInstance(galleryModalEl).show();
                    });
                });

                prevBtn.addEventListener("click", () => showPhoto(currentIndex - 1));
                nextBtn.addEventListener("click", () => showPhoto(currentIndex + 1));

                galleryModalEl.addEventListener("keydown", (e) => {
                    if (e.key === "ArrowLeft") showPhoto(currentIndex - 1);
                    else if (e.key === "ArrowRight") showPhoto(currentIndex + 1);
                });
            }
        })();
    </script>
}