@model IEnumerable<DSM_Odyss.Web.ViewModels.CarpetaViewModel>

@{
    ViewData["Title"] = "Galería de recuerdos";
}

<style>
    .tarjeta-enlace { color: inherit; text-decoration: none; transition: background .15s; }
    .tarjeta-enlace:hover { background: #f8f9fa; }
</style>

<div class="container py-2" style="max-width: 550px;">

    @* Cabecera sin pestañas: el botón de volver lleva a Mi perfil *@
    @await Component.InvokeAsync("PerfilCabecera")

    <h2 class="h4 fw-semibold mb-1">Galería de recuerdos</h2>
    <p class="text-muted small mb-3">Tus carpetas y las que otras personas han compartido contigo.</p>

    @if (Model.Any())
    {
        <div class="row row-cols-3 g-2">
            @foreach (var item in Model)
            {
                <div class="col">
                    <a asp-controller="Carpeta" asp-action="Details" asp-route-id="@item.Id"
                       class="tarjeta-enlace d-block text-center rounded-3 p-1 h-100">
                        <div class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-folder-fill text-warning" style="font-size: 3.5rem;"></i>
                        </div>
                        <div class="small fw-semibold text-truncate">@item.Nombre</div>
                        <div class="text-muted text-truncate" style="font-size: .7rem;">@item.ViajeTitulo</div>
                        <div class="text-muted" style="font-size: .7rem;">@item.TotalArchivos recuerdos</div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-folder2-open fs-1 d-block mb-2"></i>
            <p class="mb-1">Todavía no tienes carpetas de viaje.</p>
            <p class="small mb-0">Abre uno de tus viajes para crear su carpeta de recuerdos.</p>
        </div>
    }

</div>