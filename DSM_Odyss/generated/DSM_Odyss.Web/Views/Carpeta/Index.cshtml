@model IEnumerable<DSM_Odyss.Web.ViewModels.CarpetaViewModel>

@{
    ViewData["Title"] = "Carpetas de viaje";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Carpetas de viaje</h1>
            <p class="text-body-secondary mb-0">Tus carpetas y las que otras personas han compartido contigo.</p>
        </div>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 p-3">
            @foreach (var item in Model)
            {
                <div class="col">
                    <a asp-action="Details" asp-route-id="@item.Id" class="card h-100 text-decoration-none text-body shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <span class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                                    <i class="bi bi-folder2-open fs-4"></i>
                                </span>
                                <div class="min-w-0">
                                    <h2 class="h6 mb-1 text-truncate">@item.Nombre</h2>
                                    <div class="small text-body-secondary text-truncate">@item.ViajeTitulo</div>
                                </div>
                            </div>
                            <span class="small text-body-secondary">@item.TotalArchivos recuerdos</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no tienes carpetas de viaje</h2>
            <p class="text-body-secondary">Abre uno de tus viajes para crear su carpeta de recuerdos.</p>
            <a asp-controller="Viaje" asp-action="Index" class="btn btn-primary">Ver mis viajes</a>
        </div>
    }
    </div>
</div>
