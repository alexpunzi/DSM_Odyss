@{
    ViewData["Title"] = "Página Inicial - Odyss";
}

<!-- Incluimos Bootstrap Icons si no los tienes en el layout -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-2" style="max-width: 600px;">

    <!-- 1. BARRA SUPERIOR / BUSCADOR (Mockup M07) -->
    <div class="d-flex align-items-center gap-2 mb-3">
        <button class="btn btn-outline-secondary rounded-circle p-2" type="button" title="Menú">
            <i class="bi bi-list fs-5"></i>
        </button>
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 bg-white" placeholder="Buscar viajes..." aria-label="Buscar viajes">
            <button class="btn btn-outline-secondary border-start-0 rounded-end-pill" type="button" title="Filtros">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
        <a asp-controller="Cliente" asp-action="Details" asp-route-id="@User.Identity?.Name" class="btn btn-outline-secondary rounded-circle p-2" title="Perfil">
            <i class="bi bi-person fs-5"></i>
        </a>
    </div>

    <!-- 2. SELECTOR DE VISTAS / PÍLDORAS -->
    <div class="d-flex gap-2 mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-pill px-3 py-1 btn-sm fw-semibold">
            <i class="bi bi-eye me-1"></i> Ver todo
        </a>
        <a asp-controller="Viaje" asp-action="Create" class="btn btn-outline-primary rounded-pill px-3 py-1 btn-sm">
            <i class="bi bi-map me-1"></i> Crear itinerario
        </a>
        <a asp-controller="Checklist" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-1 btn-sm">
            <i class="bi bi-check2-square me-1"></i> Checklists
        </a>
    </div>

    <!-- 3. SECCIÓN: VIAJES POPULARES (Carrusel / Tarjetas en scroll horizontal) -->
    <div class="mb-4">
        <h4 class="fw-bold mb-3">Viajes populares</h4>
        <div class="d-flex gap-3 overflow-auto pb-2" style="scrollbar-width: thin;">
            
            <!-- Tarjeta Viaje 1 -->
            <div class="card shadow-sm border rounded-4 flex-shrink-0" style="width: 220px;">
                <div class="bg-light d-flex align-items-center justify-content-center rounded-top-4" style="height: 140px;">
                    <i class="bi bi-image text-muted fs-1"></i>
                </div>
                <div class="card-body p-3">
                    <h6 class="card-title fw-bold mb-1">Ruta por los Alpes</h6>
                    <p class="card-text text-muted small mb-0"><i class="bi bi-person-circle me-1"></i>@@sofia_travels</p>
                </div>
            </div>

            <!-- Tarjeta Viaje 2 -->
            <div class="card shadow-sm border rounded-4 flex-shrink-0" style="width: 220px;">
                <div class="bg-light d-flex align-items-center justify-content-center rounded-top-4" style="height: 140px;">
                    <i class="bi bi-image text-muted fs-1"></i>
                </div>
                <div class="card-body p-3">
                    <h6 class="card-title fw-bold mb-1">Escapada a Kioto</h6>
                    <p class="card-text text-muted small mb-0"><i class="bi bi-person-circle me-1"></i>@@alex_pg</p>
                </div>
            </div>

            <!-- Tarjeta Viaje 3 -->
            <div class="card shadow-sm border rounded-4 flex-shrink-0" style="width: 220px;">
                <div class="bg-light d-flex align-items-center justify-content-center rounded-top-4" style="height: 140px;">
                    <i class="bi bi-image text-muted fs-1"></i>
                </div>
                <div class="card-body p-3">
                    <h6 class="card-title fw-bold mb-1">Costa Amalfitana</h6>
                    <p class="card-text text-muted small mb-0"><i class="bi bi-person-circle me-1"></i>@@marcos_v</p>
                </div>
            </div>

        </div>
    </div>

    <!-- 4. SECCIÓN: TOP 10 DESTINOS POPULARES -->
    <div class="mb-4">
        <h4 class="fw-bold mb-3">Top 10 destinos populares</h4>
        <div class="d-flex flex-column gap-2">

            <!-- Item Destino 1 -->
            <div class="card border rounded-3 p-2 shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-light border rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                        <i class="bi bi-geo-alt fs-4 text-primary"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-0">Tokio, Japón</h6>
                        <small class="text-muted d-block">Metrópolis, templos y gastronomía</small>
                        <span class="badge bg-light text-secondary border mt-1">12.450 viajeros</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted me-2"></i>
                </div>
            </div>

            <!-- Item Destino 2 -->
            <div class="card border rounded-3 p-2 shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-light border rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                        <i class="bi bi-geo-alt fs-4 text-primary"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-0">Roma, Italia</h6>
                        <small class="text-muted d-block">Historia, arte y monumentos clásicos</small>
                        <span class="badge bg-light text-secondary border mt-1">9.820 viajeros</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted me-2"></i>
                </div>
            </div>

            <!-- Item Destino 3 -->
            <div class="card border rounded-3 p-2 shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-light border rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                        <i class="bi bi-geo-alt fs-4 text-primary"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-0">Reikiavik, Islandia</h6>
                        <small class="text-muted d-block">Naturaleza, glaciares y auroras</small>
                        <span class="badge bg-light text-secondary border mt-1">5.110 viajeros</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted me-2"></i>
                </div>
            </div>

        </div>
    </div>

</div>