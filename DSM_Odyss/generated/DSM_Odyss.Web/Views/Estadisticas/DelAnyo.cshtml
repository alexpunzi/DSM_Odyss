@model DSM_Odyss.Web.ViewModels.ConsultaResultadoViewModel<int, DSM_Odyss.Web.ViewModels.EstadisticasViewModel>

@{
    ViewData["Title"] = "Estadísticas por año";
}

<div class="container py-2" style="max-width: 550px;">
    <h2 class="h4 fw-semibold mb-3"><i class="bi bi-bar-chart me-2"></i>Estadísticas del año</h2>

    <form asp-action="DelAnyo" method="get" class="card card-body border-0 shadow-sm rounded-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col">
                <label for="p_anyo" class="form-label small fw-semibold mb-1">Año</label>
                <input id="p_anyo" name="p_anyo" type="number" class="form-control form-control-sm" value="@Model.Parametro" min="2000" max="2100" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>
            </div>
        </div>
    </form>

    @if (!Model.Resultados.Any())
    {
        <div class="alert alert-light border text-muted text-center">No hay estadísticas para el año @Model.Parametro.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Año</th>
                        <th>Países</th>
                        <th>Fotos</th>
                        <th>Destino top</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Resultados)
                    {
                        <tr>
                            <td>@(item.Anyo?.ToString() ?? "-")</td>
                            <td>@(item.PaisesVisitados ?? 0)</td>
                            <td>@(item.FotosSubidas ?? 0)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.DestinoMasVisitado) ? "-" : item.DestinoMasVisitado)</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
