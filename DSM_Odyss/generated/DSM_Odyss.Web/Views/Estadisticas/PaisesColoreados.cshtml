@model IReadOnlyList<string>

@{
    ViewData["Title"] = "Países coloreados";
}

<div class="container py-2" style="max-width: 550px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-semibold mb-0"><i class="bi bi-map me-2"></i>Países coloreados</h2>
        <form asp-action="PaisesColoreados" method="get" class="m-0">
            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border text-muted text-center">No hay países coloreados todavía.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>País</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td class="fw-semibold">@Model[i]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
