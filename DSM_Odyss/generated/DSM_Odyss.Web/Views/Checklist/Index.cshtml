@model IEnumerable<DSM_Odyss.Web.ViewModels.ChecklistViewModel>

@{
    ViewData["Title"] = "Mis checklists";
}

<div class="container py-3" style="max-width: 480px;">
    @* Cabecera igual al mockup *@
    <div class="mb-3">
        <h1 class="h3 fw-bold mb-1" style="color: #1e293b;">Mis checklists</h1>
        <p class="text-muted small mb-3">Organiza tus viajes y no te olvides de nada!</p>

        <a asp-action="Create" class="btn w-100 fw-medium py-2 shadow-sm"
           style="background-color: #93c1e8; border: 1px solid #6fa3d2; color: #1e3a5f; border-radius: 8px;">
            <i class="bi bi-plus-lg me-1"></i> Crear nueva lista
        </a>
    </div>

    <hr class="my-3 opacity-25" />

    @* Listado de tarjetas de checklists *@
    @if (Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card border shadow-sm" style="border-radius: 10px; border-color: #cbd5e1 !important;">
                    <div class="card-body py-3 px-3 d-flex align-items-center justify-content-between">
                        @* Al pulsar en el icono o nombre abre la vista Details (pantalla derecha) *@
                        <a asp-action="Details" asp-route-id="@item.Id" class="d-flex align-items-center gap-3 text-decoration-none text-dark flex-grow-1">
                            <i class="bi bi-list-ul fs-4 text-dark"></i>
                            <span class="fw-medium text-secondary">@item.Nombre</span>
                        </a>

                        @* Menú de 3 puntos verticales con las acciones originales *@
                        <div class="dropdown">
                            <button class="btn btn-link text-dark p-1 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical fs-5"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="bi bi-eye me-2"></i>Detalles
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-2"></i>Editar
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                        <i class="bi bi-trash me-2"></i>Eliminar
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-card-checklist fs-1 d-block mb-2"></i>
            <h2 class="h6 fw-bold text-dark">Todavía no hay registros</h2>
            <p class="small mb-3">Crea el primer registro para comenzar.</p>
            <a asp-action="Create" class="btn btn-sm fw-medium px-3 py-2"
               style="background-color: #93c1e8; border: 1px solid #6fa3d2; color: #1e3a5f; border-radius: 8px;">
                <i class="bi bi-plus-lg me-1"></i> Crear nueva lista
            </a>
        </div>
    }
</div>