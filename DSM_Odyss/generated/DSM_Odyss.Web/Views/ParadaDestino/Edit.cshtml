@* HARIA-WEB GENERATED sha256:9a084496d3f12caab81a7af192423114729c06d3178238e4d6fd07e3d5e3a60a *@
@model DSM_Odyss.Web.ViewModels.ParadaDestinoViewModel

@{
    ViewData["Title"] = "Editar";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Editar</span>
                <h1 class="h3 mb-1">ParadaDestino</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Orden" class="form-label"></label>
            <input asp-for="Orden" class="form-control" />
            <span asp-validation-for="Orden" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaLlegada" class="form-label"></label>
            <input asp-for="FechaLlegada" type="date" class="form-control" />
            <span asp-validation-for="FechaLlegada" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaSalida" class="form-label"></label>
            <input asp-for="FechaSalida" type="date" class="form-control" />
            <span asp-validation-for="FechaSalida" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ViajeId" class="form-label"></label>
            <select asp-for="ViajeId" asp-items="Model.ViajeOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="ViajeId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DestinoId" class="form-label"></label>
            <select asp-for="DestinoId" asp-items="Model.DestinoOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="DestinoId" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />


}
