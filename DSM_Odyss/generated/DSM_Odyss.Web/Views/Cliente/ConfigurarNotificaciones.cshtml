@model DSM_Odyss.Web.ViewModels.ConfigurarNotificacionesViewModel
@using DSM_Odyss.Domain.Enums

@{
    ViewData["Title"] = "Configurar notificaciones";
}

<style>
    .campo-caja { border: 1px solid #dee2e6; border-radius: .75rem; background: #fff; }
    .canal .btn { border-radius: .75rem; border-color: #94a3b8; color: #1e293b; }
    .canal .btn-check:checked + .btn { background: #1e293b; border-color: #1e293b; color: #fff; }
</style>

<div class="container py-3" style="max-width: 480px;">

    @* Volver a recordatorios *@
    <a asp-controller="Recordatorio" asp-action="Index" class="btn btn-light border rounded-circle mb-3" title="Volver">
        <i class="bi bi-arrow-left"></i>
    </a>

    @* Cabecera *@
    <div class="mb-3">
        <h1 class="h3 fw-bold mb-1" style="color: #1e293b;">Configurar notificaciones</h1>
        <p class="text-muted small mb-0">Elige cómo quieres que te avisemos de tus recordatorios</p>
    </div>

    @* Envía a la operación custom ConfigurarNotificaciones de ClienteController *@
    <form asp-controller="Cliente" asp-action="ConfigurarNotificaciones" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="p_oid" value="@Model.ClienteId" />

        <div class="card border shadow-sm mb-3" style="border-radius: 14px; border-color: #94a3b8 !important;">
            <div class="card-body p-3 d-flex flex-column gap-3">

                @* 1. Activar o desactivar los avisos *@
                <div class="campo-caja px-3 py-2 d-flex align-items-center justify-content-between">
                    <label class="small mb-0" for="recibir">
                        <i class="bi bi-bell me-1 text-dark"></i> Recibir recordatorios
                    </label>
                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" role="switch" id="recibir"
                               name="p_recibirRecordatorios" value="true" @(Model.RecibirRecordatorios ? "checked" : "") />
                        @* Si el interruptor está apagado, el navegador no envía nada: este oculto manda "false" *@
                        <input type="hidden" name="p_recibirRecordatorios" value="false" />
                    </div>
                </div>

                @* 2. Canal de recepción *@
                <div>
                    <div class="small fw-semibold text-dark mb-2">¿Por dónde quieres recibirlos?</div>
                    <div class="canal row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="p_canal" value="@CanalNotificacion.email" id="canal-email"
                                   @(Model.Canal == CanalNotificacion.email ? "checked" : "") />
                            <label class="btn btn-outline-secondary w-100 py-2" for="canal-email">
                                <i class="bi bi-envelope d-block fs-4 mb-1"></i>
                                <span class="small">Email</span>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="p_canal" value="@CanalNotificacion.sms" id="canal-sms"
                                   @(Model.Canal == CanalNotificacion.sms ? "checked" : "") />
                            <label class="btn btn-outline-secondary w-100 py-2" for="canal-sms">
                                <i class="bi bi-phone d-block fs-4 mb-1"></i>
                                <span class="small">SMS</span>
                            </label>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        @* Botones inferiores *@
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Recordatorio" asp-action="Index" class="btn btn-outline-dark btn-sm px-4 py-1" style="border-radius: 6px;">Cancelar</a>
            <button type="submit" class="btn btn-secondary btn-sm px-4 py-1 fw-medium"
                    style="background-color: #cbd5e1; border-color: #64748b; color: #1e293b; border-radius: 6px;">
                Guardar
            </button>
        </div>
    </form>
</div>