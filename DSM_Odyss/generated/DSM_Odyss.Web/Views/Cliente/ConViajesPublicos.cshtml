@model IReadOnlyList<DSM_Odyss.Web.ViewModels.ClienteViewModel>

@{
    ViewData["Title"] = "Clientes con viajes públicos";
}

<div class="container py-2" style="max-width: 550px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-semibold mb-0"><i class="bi bi-people me-2"></i>Clientes con viajes públicos</h2>
        <form asp-action="ConViajesPublicos" method="get" class="m-0">
            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border text-muted text-center">No hay clientes con viajes públicos.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@@@item.User</td>
                            <td>@item.Nombre @item.Apellidos</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
