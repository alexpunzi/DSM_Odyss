@{
    ViewData["Title"] = "Cambiar contraseña";
    var clienteId = ViewData["ClienteId"];
}

<style>
    .campo-caja { border: 1px solid #dee2e6; border-radius: .75rem; background: #fff; }
</style>

<div class="container py-3" style="max-width: 480px;">

    @* Volver al perfil *@
    <a asp-controller="Cliente" asp-action="Details" class="btn btn-light border rounded-circle mb-3" title="Volver">
        <i class="bi bi-arrow-left"></i>
    </a>

    <div class="mb-3">
        <h1 class="h3 fw-bold mb-1" style="color: #1e293b;">Cambiar contraseña</h1>
        <p class="text-muted small mb-0">Mínimo 8 caracteres, con al menos un número y un carácter especial</p>
    </div>

    @if (TempData["PasswordOk"] is string ok)
    {
        <div class="alert alert-success py-2 small text-center">@ok</div>
    }
    @if (TempData["PasswordError"] is string error)
    {
        <div class="alert alert-danger py-2 small">@error</div>
    }

    @* Envía a la operación custom CambiarPassword de ClienteController *@
    <form asp-controller="Cliente" asp-action="CambiarPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="p_oid" value="@clienteId" />

        <div class="card border shadow-sm mb-3" style="border-radius: 14px; border-color: #94a3b8 !important;">
            <div class="card-body p-3 d-flex flex-column gap-3">
                <div class="campo-caja px-3 py-2">
                    <label for="p_oldPass" class="form-label small text-muted mb-1"><i class="bi bi-lock me-1 text-dark"></i> Contraseña actual</label>
                    <input type="password" id="p_oldPass" name="p_oldPass" class="form-control form-control-sm" required autocomplete="current-password" />
                </div>
                <div class="campo-caja px-3 py-2">
                    <label for="p_newPass" class="form-label small text-muted mb-1"><i class="bi bi-key me-1 text-dark"></i> Nueva contraseña</label>
                    <input type="password" id="p_newPass" name="p_newPass" class="form-control form-control-sm" required minlength="8" autocomplete="new-password" />
                </div>
                <div class="campo-caja px-3 py-2">
                    <label for="p_confirmPass" class="form-label small text-muted mb-1"><i class="bi bi-key-fill me-1 text-dark"></i> Repite la nueva contraseña</label>
                    <input type="password" id="p_confirmPass" name="p_confirmPass" class="form-control form-control-sm" required minlength="8" autocomplete="new-password" />
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Cliente" asp-action="Details" class="btn btn-outline-dark btn-sm px-4 py-1" style="border-radius: 6px;">Cancelar</a>
            <button type="submit" class="btn btn-secondary btn-sm px-4 py-1 fw-medium"
                    style="background-color: #cbd5e1; border-color: #64748b; color: #1e293b; border-radius: 6px;">
                Guardar
            </button>
        </div>
    </form>
</div>
