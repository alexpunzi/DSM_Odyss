@model DSM_Odyss.Web.ViewModels.PerfilUsuarioViewModel

@{
    ViewData["Title"] = "Mi perfil";
}

<style>
    .seccion-titulo { color: inherit; text-decoration: none; }
    .seccion-titulo:hover { opacity: .7; }
    .imagen-vacia {
        background: #f1f3f5;
        display: flex; align-items: center; justify-content: center;
        color: #adb5bd;
    }
    .tarjeta-enlace { color: inherit; text-decoration: none; transition: background .15s; }
    .tarjeta-enlace:hover { background: #f8f9fa; }
</style>

<div class="container py-2" style="max-width: 550px;">

    @await Component.InvokeAsync("PerfilCabecera", new { pestana = "galeria" })

    @* ===== MIS VIAJES (M08) ===== *@
    <section class="mb-4">
        <h2 class="h4 fw-semibold mb-2">Mis viajes</h2>

        @if (!Model.Viajes.Any())
        {
            <p class="text-muted small mb-0">Todavía no tienes viajes públicos.</p>
        }
        else
        {
            <div class="d-flex gap-3 overflow-auto pb-2" style="scrollbar-width: thin;">
                @foreach (var viaje in Model.Viajes)
                {
                    <a asp-controller="Viaje" asp-action="Details" asp-route-id="@viaje.Id"
                       class="tarjeta-enlace card border rounded-3 flex-shrink-0" style="width: 150px;">
                        <div class="imagen-vacia rounded-top-3" style="height: 110px;">
                            <i class="bi bi-image fs-1"></i>
                        </div>
                        <div class="card-body p-2">
                            <div class="fw-semibold small text-truncate">@viaje.Titulo</div>
                            <div class="text-muted" style="font-size: .75rem;">@viaje.FechaInicio.ToString("dd/MM/yyyy")</div>
                        </div>
                    </a>
                }
            </div>
        }
    </section>

    @* ===== RESEÑAS RECIENTES (M08 / M16) ===== *@
    <section class="mb-4">
        <a asp-controller="Resena" asp-action="Index" class="seccion-titulo d-inline-flex align-items-center gap-1 mb-2">
            <h2 class="h4 fw-semibold mb-0">Reseñas recientes</h2>
            <i class="bi bi-chevron-right"></i>
        </a>

        @if (!Model.Resenas.Any())
        {
            <p class="text-muted small mb-0">Todavía no has escrito ninguna reseña.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var resena in Model.Resenas)
                {
                    <a asp-controller="Resena" asp-action="Details" asp-route-id="@resena.Id"
                       class="tarjeta-enlace d-flex align-items-center gap-3 border rounded-3 p-2">
                        <div class="imagen-vacia rounded-circle flex-shrink-0" style="width: 48px; height: 48px;">
                            <i class="bi bi-airplane fs-5"></i>
                        </div>
                        <div style="min-width: 0;">
                            <div class="fw-semibold small text-truncate">@resena.TituloViaje</div>
                            <div class="text-warning small" title="@resena.Puntuacion de 5">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= resena.Puntuacion ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                            <div class="text-muted" style="font-size: .75rem;">@resena.FechaViaje.ToString("dd/MM/yyyy")</div>
                        </div>
                    </a>
                }
            </div>
        }
    </section>

    @* ===== GALERÍA DE RECUERDOS (M16) ===== *@
    <section class="mb-4">
        <a asp-controller="Carpeta" asp-action="Index" class="seccion-titulo d-inline-flex align-items-center gap-1 mb-2">
            <h2 class="h4 fw-semibold mb-0">Galería de recuerdos</h2>
            <i class="bi bi-chevron-right"></i>
        </a>

        @if (!Model.Carpetas.Any())
        {
            <p class="text-muted small mb-0">Todavía no tienes carpetas de recuerdos.</p>
        }
        else
        {
            <div class="row row-cols-3 g-2">
                @foreach (var carpeta in Model.Carpetas)
                {
                    <div class="col">
                        <a asp-controller="Carpeta" asp-action="Details" asp-route-id="@carpeta.Id"
                           class="tarjeta-enlace d-block text-center rounded-3 p-1">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="bi bi-folder-fill text-warning" style="font-size: 3.5rem;"></i>
                            </div>
                            <div class="small text-truncate">@carpeta.Nombre</div>
                            <div class="text-muted" style="font-size: .7rem;">@carpeta.TotalArchivos archivos</div>
                        </a>
                    </div>
                }
            </div>
        }
    </section>

</div>