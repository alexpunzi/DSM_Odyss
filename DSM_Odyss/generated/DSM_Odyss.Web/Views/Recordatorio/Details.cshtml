@model DSM_Odyss.Web.ViewModels.RecordatorioViewModel
@using DSM_Odyss.Domain.Enums

@{
    ViewData["Title"] = Model.Titulo;
    var esAlarma = Model.TipoAviso == TipoAviso.alarma;
}

<style>
    .campo-caja { border: 1px solid #dee2e6; border-radius: .75rem; background: #fff; }
</style>

<div class="container py-3" style="max-width: 480px;">

    @* Volver al listado *@
    <a asp-action="Index" class="btn btn-light border rounded-circle mb-3" title="Volver">
        <i class="bi bi-arrow-left"></i>
    </a>

    @* Cabecera: icono, título y estado *@
    <div class="d-flex align-items-center gap-3 mb-3">
        <i class="bi @(esAlarma ? "bi-alarm" : "bi-bell") fs-2" style="color: #1e293b;"></i>
        <div class="flex-grow-1" style="min-width: 0;">
            <h1 class="h4 fw-bold mb-1 text-break" style="color: #1e293b;">@Model.Titulo</h1>
            @if (Model.Enviado)
            {
                <span class="badge rounded-pill text-bg-secondary">Enviado</span>
            }
            else
            {
                <span class="badge rounded-pill text-bg-warning">Pendiente</span>
            }
        </div>
    </div>

    <div class="card border shadow-sm mb-3" style="border-radius: 14px; border-color: #94a3b8 !important;">
        <div class="card-body p-3 d-flex flex-column gap-3">

            @* Detalles (solo si tiene) *@
            @if (!string.IsNullOrWhiteSpace(Model.Detalles))
            {
                <div class="campo-caja px-3 py-2 d-flex align-items-start gap-2">
                    <i class="bi bi-text-paragraph text-dark mt-1"></i>
                    <div class="small" style="white-space: pre-line;">@Model.Detalles</div>
                </div>
            }

            @* Fecha y hora *@
            <div class="row g-2">
                <div class="col-7">
                    <div class="campo-caja px-3 py-2">
                        <div class="small text-muted mb-1"><i class="bi bi-calendar-event me-1 text-dark"></i> Fecha</div>
                        <div class="small fw-medium">@Model.Fecha.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
                <div class="col-5">
                    <div class="campo-caja px-3 py-2">
                        <div class="small text-muted mb-1"><i class="bi bi-clock me-1 text-dark"></i> Hora</div>
                        <div class="small fw-medium">@Model.Hora.ToString("HH:mm")</div>
                    </div>
                </div>
            </div>

            @* Tipo de aviso *@
            <div class="campo-caja px-3 py-2 d-flex align-items-center gap-2">
                <i class="bi @(esAlarma ? "bi-alarm" : "bi-bell") text-dark"></i>
                <span class="small">@(esAlarma ? "Alarma" : "Notificación")</span>
            </div>

            @* Tarea asociada (solo si tiene) *@
            @if (!string.IsNullOrWhiteSpace(Model.TareaLabel))
            {
                <div class="campo-caja px-3 py-2 d-flex align-items-center gap-2">
                    <i class="bi bi-check2-square text-dark"></i>
                    <span class="small">@Model.TareaLabel</span>
                </div>
            }
        </div>
    </div>

    @* Botones *@
    <div class="d-grid gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <button type="button" class="btn btn-outline-danger"
                data-bs-toggle="modal" data-bs-target="#modalBorrarRecordatorio">
            <i class="bi bi-trash me-1"></i> Borrar recordatorio
        </button>
    </div>
</div>

@* ===== Ventana de confirmación para borrar ===== *@
<div class="modal fade" id="modalBorrarRecordatorio" tabindex="-1" aria-labelledby="modalBorrarRecordatorioTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 14px;">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 2.5rem;"></i>
                <h2 class="h5 fw-semibold mt-2" id="modalBorrarRecordatorioTitulo">¿Borrar "@Model.Titulo"?</h2>
                <p class="small text-muted mb-0">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-4">
                <button type="button" class="btn btn-outline-dark btn-sm px-4" data-bs-dismiss="modal">Cancelar</button>
                <form asp-controller="Recordatorio" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm px-4">Borrar</button>
                </form>
            </div>
        </div>
    </div>
</div>