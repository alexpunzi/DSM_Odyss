@model DSM_Odyss.Web.ViewModels.RecordatorioViewModel
@using DSM_Odyss.Domain.Enums

@{
    ViewData["Title"] = "Nuevo recordatorio";
}

<style>
    .campo-caja { border: 1px solid #dee2e6; border-radius: .75rem; background: #fff; }
    .tipo-aviso .btn { border-radius: .75rem; border-color: #94a3b8; color: #1e293b; }
    .tipo-aviso .btn-check:checked + .btn { background: #1e293b; border-color: #1e293b; color: #fff; }
</style>

<div class="container py-3" style="max-width: 480px;">

    @* Cabecera *@
    <div class="mb-3">
        <h1 class="h3 fw-bold mb-1" style="color: #1e293b;">Nuevo recordatorio</h1>
        <p class="text-muted small mb-0">Rellena los datos para que no se te olvide nada</p>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
        }

        @* Un recordatorio nuevo siempre empieza sin enviar *@
        <input type="hidden" name="Enviado" value="false" />

        <div class="card border shadow-sm mb-3" style="border-radius: 14px; border-color: #94a3b8 !important;">
            <div class="card-body p-3 d-flex flex-column gap-3">

                @* 1. Título *@
                <div>
                    <div class="campo-caja px-3 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-fill text-dark"></i>
                        <input asp-for="Titulo" class="form-control border-0 shadow-none p-0 small fw-medium"
                               placeholder="Título del recordatorio" />
                    </div>
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                @* 2. Detalles *@
                <div>
                    <div class="campo-caja px-3 py-2 d-flex align-items-start gap-2">
                        <i class="bi bi-text-paragraph text-dark mt-1"></i>
                        <textarea asp-for="Detalles" rows="3" class="form-control border-0 shadow-none p-0 small"
                                  placeholder="Detalles (qué tienes que hacer, dónde…)"></textarea>
                    </div>
                    <span asp-validation-for="Detalles" class="text-danger small"></span>
                </div>

                @* 3. Fecha y hora *@
                <div class="row g-2">
                    <div class="col-7">
                        <div class="campo-caja px-3 py-2">
                            <label asp-for="Fecha" class="form-label small text-muted mb-1">
                                <i class="bi bi-calendar-event me-1 text-dark"></i> Fecha
                            </label>
                            <input asp-for="Fecha" type="date" class="form-control form-control-sm" />
                        </div>
                        <span asp-validation-for="Fecha" class="text-danger small"></span>
                    </div>
                    <div class="col-5">
                        <div class="campo-caja px-3 py-2">
                            <label asp-for="Hora" class="form-label small text-muted mb-1">
                                <i class="bi bi-clock me-1 text-dark"></i> Hora
                            </label>
                            <input asp-for="Hora" type="time" value="@Model.Hora.ToString("HH:mm")" class="form-control form-control-sm" />
                        </div>
                        <span asp-validation-for="Hora" class="text-danger small"></span>
                    </div>
                </div>

                @* 4. Tipo de aviso *@
                <div>
                    <div class="small fw-semibold text-dark mb-2">Tipo de aviso</div>
                    <div class="tipo-aviso row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="TipoAviso" value="@TipoAviso.notificacion" id="tipo-notificacion" />
                            <label class="btn btn-outline-secondary w-100 py-2" for="tipo-notificacion">
                                <i class="bi bi-bell d-block fs-4 mb-1"></i>
                                <span class="small">Notificación</span>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="TipoAviso" value="@TipoAviso.alarma" id="tipo-alarma" />
                            <label class="btn btn-outline-secondary w-100 py-2" for="tipo-alarma">
                                <i class="bi bi-alarm d-block fs-4 mb-1"></i>
                                <span class="small">Alarma</span>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="TipoAviso" class="text-danger small"></span>
                </div>

                @* 5. Tarea asociada (opcional) *@
                @if (Model.TareaOptions.Any())
                {
                    <div>
                        <div class="campo-caja px-3 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-check2-square text-dark"></i>
                            <select asp-for="TareaId" asp-items="Model.TareaOptions" class="form-select form-select-sm border-0 shadow-none p-0 small">
                                <option value="">Vincular a una tarea (opcional)</option>
                            </select>
                        </div>
                        <span asp-validation-for="TareaId" class="text-danger small"></span>
                    </div>
                }

            </div>
        </div>

        @* Botones inferiores: Cancelar y Crear *@
        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Index" class="btn btn-outline-dark btn-sm px-4 py-1" style="border-radius: 6px;">Cancelar</a>
            <button type="submit" class="btn btn-secondary btn-sm px-4 py-1 fw-medium"
                    style="background-color: #cbd5e1; border-color: #64748b; color: #1e293b; border-radius: 6px;">
                Crear recordatorio
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}