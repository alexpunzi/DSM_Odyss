@model IEnumerable<DSM_Odyss.Web.ViewModels.RecordatorioViewModel>
@using DSM_Odyss.Domain.Enums

@{
    ViewData["Title"] = "Notificaciones y recordatorios";
    var pendientes = Model.Count(r => !r.Enviado);
    var avisosEnviados = ViewData["AvisosEnviados"] as List<string> ?? new List<string>();
    var canalAviso = ViewData["CanalAviso"] as string ?? "email";
}

<style>
    .recordatorio-card {
        border: 1.5px solid #6c757d;
        border-radius: .75rem;
        transition: background .15s;
    }
    .recordatorio-card:hover { background: #f8f9fa; }
</style>

<div class="container py-2" style="max-width: 550px;">

    @await Component.InvokeAsync("PerfilCabecera", new { compacta = true })

    @* Título con campana y nº de pendientes *@
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="position-relative d-inline-flex">
            <i class="bi bi-bell fs-3"></i>
            @if (pendientes > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @(pendientes > 9 ? "9+" : pendientes.ToString())
                </span>
            }
        </span>
        <h1 class="h5 fw-semibold mb-0">Notificaciones y recordatorios</h1>
    </div>

    @* CU-15: avisos que se acaban de enviar porque ya ha llegado su hora *@
    @if (avisosEnviados.Any())
    {
        <div class="alert alert-info py-2 small" role="alert">
            <div class="fw-semibold mb-1">
                <i class="bi bi-send-check me-1"></i>
                Te hemos avisado por @canalAviso de:
            </div>
            <ul class="mb-0 ps-3">
                @foreach (var titulo in avisosEnviados)
                {
                    <li>@titulo</li>
                }
            </ul>
        </div>
    }

    @* Mensaje tras guardar la configuración *@
    @if (TempData["MensajeNotificaciones"] is string mensaje)
    {
        <div class="alert alert-success py-2 small text-center">@mensaje</div>
    }

    @* Botones *@
    <div class="d-grid gap-2 mb-4">
        <a asp-controller="Cliente" asp-action="ConfigurarNotificaciones" class="btn btn-light border btn-sm">
            <i class="bi bi-gear me-1"></i> Configurar notificaciones
        </a>
        <a asp-controller="Recordatorio" asp-action="Create" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo recordatorio
        </a>
    </div>

    @* Lista de recordatorios *@
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
            No tienes recordatorios todavía.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var r in Model)
            {
                <a asp-controller="Recordatorio" asp-action="Details" asp-route-id="@r.Id"
                   class="recordatorio-card d-flex align-items-center gap-3 p-3 text-decoration-none text-body @(r.Enviado ? "opacity-50" : "")">

                    <i class="bi @(r.TipoAviso == TipoAviso.alarma ? "bi-alarm" : "bi-bell") fs-3"></i>

                    <div class="flex-grow-1" style="min-width: 0;">
                        <div class="fw-semibold small text-truncate">@r.Titulo</div>
                        <div class="text-muted small text-truncate">@r.Detalles</div>
                    </div>

                    <small class="text-muted text-nowrap align-self-end">
                        @r.Fecha.ToString("dd/MM") a las @r.Hora.ToString("HH:mm")
                    </small>
                </a>
            }
        </div>
    }

</div>