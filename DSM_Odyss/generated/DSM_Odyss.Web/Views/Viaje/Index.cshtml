@model IEnumerable<DSM_Odyss.Web.ViewModels.ViajeViewModel>

@{
    ViewData["Title"] = "Mis viajes privados";
}

<style>
    .imagen-vacia {
        background: #f1f3f5;
        display: flex; align-items: center; justify-content: center;
        color: #adb5bd;
    }
    .tarjeta-enlace { color: inherit; text-decoration: none; transition: background .15s; }
    .tarjeta-enlace:hover { background: #f8f9fa; }
</style>

<div class="container py-2" style="max-width: 550px;">

    @await Component.InvokeAsync("PerfilCabecera", new { pestana = "itinerarios" })

    <h2 class="h4 fw-semibold mb-3">Mis viajes privados</h2>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-lock fs-1 d-block mb-2"></i>
            <p class="mb-0">No tienes viajes privados.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 g-3">
            @foreach (var viaje in Model)
            {
                <div class="col">
                    <a asp-controller="Viaje" asp-action="Details" asp-route-id="@viaje.Id"
                       class="tarjeta-enlace card border rounded-3 h-100">
                        <div class="imagen-vacia rounded-top-3" style="height: 130px;">
                            <i class="bi bi-image fs-1"></i>
                        </div>
                        <div class="card-body p-2">
                            <div class="fw-semibold small text-truncate">@viaje.Titulo</div>
                            <div class="text-muted" style="font-size: .75rem;">@viaje.FechaInicio.ToString("dd/MM/yyyy")</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

</div>