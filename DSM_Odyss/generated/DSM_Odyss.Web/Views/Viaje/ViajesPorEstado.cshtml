@using DSM_Odyss.Domain.Enums
@model DSM_Odyss.Web.ViewModels.ConsultaResultadoViewModel<EstadoViaje, DSM_Odyss.Web.ViewModels.ViajeViewModel>

@{
    ViewData["Title"] = "Viajes por estado";
}

<div class="container py-2" style="max-width: 550px;">
    <h2 class="h4 fw-semibold mb-3"><i class="bi bi-funnel me-2"></i>Viajes por estado</h2>

    <form asp-action="ViajesPorEstado" method="get" class="card card-body border-0 shadow-sm rounded-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col">
                <label for="p_estado" class="form-label small fw-semibold mb-1">Estado del viaje</label>
                <select id="p_estado" name="p_estado" class="form-select form-select-sm"
                        asp-items="Html.GetEnumSelectList<EstadoViaje>()" asp-for="Parametro"></select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>
            </div>
        </div>
    </form>

    @if (!Model.Resultados.Any())
    {
        <div class="alert alert-light border text-muted text-center">No hay viajes con ese estado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Público</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Resultados)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Titulo</td>
                            <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>@(item.EsPublico ? "Sí" : "No")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
