@model DSM_Odyss.Web.ViewModels.ViajeViewModel

@{
    ViewData["Title"] = "Detalles del viaje";
}

<div class="container py-3" style="max-width: 480px;">
    @* Cabecera igual al mockup *@
    <div class="mb-2">
        <h1 class="h3 fw-bold mb-1" style="color: #1e293b;">@(Model?.Titulo ?? string.Empty)</h1>
        <p class="text-muted small mb-2">Consulta los detalles de tu viaje</p>
    </div>

    @* Flecha atrás (<) *@
    <div class="mb-3">
        <a asp-controller="@(User.Identity?.IsAuthenticated == true ? "Viaje" : "Home")"
           asp-action="Index" class="text-dark text-decoration-none fs-4 d-inline-flex align-items-center" title="Volver">
            <i class="bi bi-chevron-left"></i>
        </a>
    </div>

    @* Tarjeta principal con estética del mockup *@
    <div class="card border shadow-sm mb-3" style="border-radius: 14px; border-color: #94a3b8 !important;">
        <div class="card-body p-3 d-flex flex-column gap-3">

            @* Título *@
            <div class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 bg-light">
                <i class="bi bi-pencil-fill text-dark"></i>
                <span class="small fw-semibold text-dark">@(Model?.Titulo ?? string.Empty)</span>
            </div>

            @* Destinos del viaje (si existen) *@
            @if (Model?.Destinos != null && Model.Destinos.Any())
            {
                <div class="border rounded-3 p-3 bg-white d-flex flex-column gap-2">
                    <div class="small fw-semibold text-muted mb-1">Destinos</div>
                    @foreach (var dest in Model.Destinos)
                    {
                        <div class="border-bottom pb-2">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt text-dark"></i>
                                    <span class="small fw-medium text-dark">
                                        @(!string.IsNullOrWhiteSpace(dest.Ciudad) ? dest.Ciudad : $"Destino #{dest.Orden}")
                                        @if (!string.IsNullOrWhiteSpace(dest.Pais))
                                        {
                                            <span class="text-muted">(@dest.Pais)</span>
                                        }
                                    </span>
                                </div>
                                <span class="badge bg-light text-secondary border" style="font-size: 0.72rem;">#@dest.Orden</span>
                            </div>
                            <div class="mt-1 ps-4 small text-muted">
                                @dest.FechaLlegada.ToString("dd/MM/yyyy") — @dest.FechaSalida.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    }
                </div>
            }

            @* Fechas *@
            <div class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 bg-light">
                <i class="bi bi-calendar-event text-dark"></i>
                <span class="small text-dark">De: @(Model?.FechaInicio.ToString("dd/MM/yyyy")) — Hasta: @(Model?.FechaFin.ToString("dd/MM/yyyy"))</span>
            </div>

            @* Presupuesto *@
            <div class="border rounded-3 px-3 py-2 d-flex align-items-center justify-content-between bg-light">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-cash-stack text-dark"></i>
                    <span class="small text-dark">Presupuesto total</span>
                </div>
                <span class="small fw-semibold text-dark">@((Model?.Presupuesto ?? 0f).ToString("0.##")) €</span>
            </div>

            @* Paradas / Actividades (si existen) *@
            @if (Model?.Paradas != null && Model.Paradas.Any())
            {
                <div class="border rounded-3 p-3 bg-white d-flex flex-column gap-2">
                    <div class="small fw-semibold text-muted mb-1">Paradas / Actividades</div>
                    @foreach (var parada in Model.Paradas)
                    {
                        <div class="border-bottom pb-2 last-child-no-border">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-bank text-dark"></i>
                                    <span class="small fw-medium text-dark">@parada.Nombre</span>
                                </div>
                                <span class="badge bg-light text-secondary border" style="font-size: 0.72rem;">@parada.Dia Día</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(parada.Horario) || !string.IsNullOrWhiteSpace(parada.Detalles))
                            {
                                <div class="mt-1 ps-4 small text-muted">
                                    @if (!string.IsNullOrWhiteSpace(parada.Horario))
                                    {
                                        <span class="me-2"><i class="bi bi-clock me-1"></i>@parada.Horario</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(parada.Detalles))
                                    {
                                        <span>@parada.Detalles</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* Metadatos del viaje *@
            <div class="px-1 small text-muted d-flex flex-column gap-1">
                <div class="d-flex justify-content-between">
                    <span>Tipo de viaje:</span>
                    <span class="fw-medium text-dark">@Html.DisplayFor(model => model.TipoViaje)</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Estado:</span>
                    <span class="fw-medium text-dark">@Html.DisplayFor(model => model.Estado)</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Visibilidad:</span>
                    <span class="fw-medium text-dark">@((Model?.EsPublico ?? false) ? "Viaje público" : "Privado")</span>
                </div>
                @if (Model?.EsPropietario == true && Model.CarpetasId is int carpetaId)
                {
                    <div class="d-flex justify-content-between">
                        <span>Carpeta:</span>
                        <a asp-controller="Carpeta" asp-action="Details" asp-route-id="@carpetaId" class="fw-medium">
                            @(Model.CarpetasLabel ?? "Abrir carpeta de viaje")
                        </a>
                    </div>
                }
                else if (Model?.EsPropietario == true)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Carpeta de recuerdos:</span>
                        <a asp-controller="Carpeta" asp-action="Create" asp-route-viajeId="@Model.Id" class="btn btn-sm btn-outline-primary">
                            Crear carpeta
                        </a>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model?.CollagesLabel))
                {
                    <div class="d-flex justify-content-between">
                        <span>Collage:</span>
                        <span class="fw-medium text-dark">@Model.CollagesLabel</span>
                    </div>
                }
            </div>

        </div>
    </div>

    @* Botones inferiores *@
    <div class="d-flex justify-content-end gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Viaje" asp-action="Index" class="btn btn-outline-dark btn-sm px-3 py-1" style="border-radius: 6px;">Volver</a>
            <a asp-controller="Viaje" asp-action="Edit" asp-route-id="@(Model?.Id ?? 0)" class="btn btn-secondary btn-sm px-4 py-1 fw-medium"
               style="background-color: #cbd5e1; border-color: #64748b; color: #1e293b; border-radius: 6px;">
                Editar
            </a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-sm px-3 py-1" style="border-radius: 6px;">Volver al inicio</a>
        }
    </div>
</div>