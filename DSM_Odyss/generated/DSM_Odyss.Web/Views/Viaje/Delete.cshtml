@model DSM_Odyss.Web.ViewModels.ViajeViewModel

@{
    ViewData["Title"] = "Eliminar itinerario";
}

<div class="container py-3" style="max-width: 480px;">
    @* Cabecera igual al mockup *@
    <div class="mb-2">
        <h1 class="h3 fw-bold mb-1" style="color: #1e293b;">Eliminar itinerario</h1>
        <p class="text-muted small mb-2">Esta acción no se puede deshacer</p>
    </div>

    @* Flecha atrás (<) *@
    <div class="mb-3">
        <a asp-action="Index" class="text-dark text-decoration-none fs-4 d-inline-flex align-items-center" title="Volver">
            <i class="bi bi-chevron-left"></i>
        </a>
    </div>

    @* Tarjeta principal con estética del mockup *@
    <div class="card border shadow-sm mb-3" style="border-radius: 14px; border-color: #94a3b8 !important;">
        <div class="card-body p-3 d-flex flex-column gap-3">

            <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>¿Seguro que quieres eliminar este viaje? Esta acción no se puede deshacer.</span>
            </div>

            @* Título *@
            <div class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 bg-light">
                <i class="bi bi-pencil-fill text-dark"></i>
                <span class="small fw-semibold text-dark">@Model.Titulo</span>
            </div>

            @* Fechas *@
            <div class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 bg-light">
                <i class="bi bi-calendar-event text-dark"></i>
                <span class="small text-dark">@Model.FechaInicio.ToString("dd/MM/yyyy") — @Model.FechaFin.ToString("dd/MM/yyyy")</span>
            </div>

            @* Presupuesto *@
            <div class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 bg-light">
                <i class="bi bi-cash-stack text-dark"></i>
                <span class="small text-dark">@Model.Presupuesto.ToString("0.##") €</span>
            </div>

            @* Detalles adicionales del modelo *@
            <div class="px-1 small text-muted d-flex flex-column gap-1">
                <div class="d-flex justify-content-between">
                    <span>Tipo de viaje:</span>
                    <span class="fw-medium text-dark">@Html.DisplayFor(model => model.TipoViaje)</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Estado:</span>
                    <span class="fw-medium text-dark">@Html.DisplayFor(model => model.Estado)</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Visibilidad:</span>
                    <span class="fw-medium text-dark">@(Model.EsPublico ? "Itinerario público" : "Privado")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.CarpetasLabel))
                {
                    <div class="d-flex justify-content-between">
                        <span>Carpeta:</span>
                        <span class="fw-medium text-dark">@Model.CarpetasLabel</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CollagesLabel))
                {
                    <div class="d-flex justify-content-between">
                        <span>Collage:</span>
                        <span class="fw-medium text-dark">@Model.CollagesLabel</span>
                    </div>
                }
            </div>

        </div>
    </div>

    @* Botones inferiores *@
    <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-dark btn-sm px-3 py-1" style="border-radius: 6px;">Cancelar</a>
        <button type="submit" class="btn btn-danger btn-sm px-3 py-1 fw-medium" style="border-radius: 6px;">Eliminar definitivamente</button>
    </form>
</div>