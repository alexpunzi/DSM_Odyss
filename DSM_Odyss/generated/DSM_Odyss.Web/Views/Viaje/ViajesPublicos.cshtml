@model IReadOnlyList<DSM_Odyss.Web.ViewModels.ViajeViewModel>

@{
    ViewData["Title"] = "Viajes públicos";
}

<div class="container py-2" style="max-width: 550px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-semibold mb-0"><i class="bi bi-globe-americas me-2"></i>Viajes públicos</h2>
        <form asp-action="ViajesPublicos" method="get" class="m-0">
            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border text-muted text-center">No hay viajes públicos disponibles.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Titulo</td>
                            <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge text-bg-secondary">@item.Estado</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
