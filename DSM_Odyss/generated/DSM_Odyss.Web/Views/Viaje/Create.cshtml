@model DSM_Odyss.Web.ViewModels.ViajeViewModel

@{
    ViewData["Title"] = "Crear itinerario";
}

<div class="container py-3" style="max-width: 480px;">
    @* Cabecera igual al mockup *@
    <div class="mb-3">
        <h1 class="h3 fw-bold mb-1" style="color: #1e293b;">Formulario de planificación</h1>
        <p class="text-muted small mb-0">Rellena los datos para crear el itinerario de tu viaje</p>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>

        @* Contenedor principal con borde redondeado *@
        <div class="card border shadow-sm mb-3" style="border-radius: 14px; border-color: #94a3b8 !important;">
            <div class="card-body p-3 d-flex flex-column gap-3">

                @* 1. Título del itinerario *@
                <div class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 bg-white">
                    <i class="bi bi-pencil-fill text-dark"></i>
                    <input asp-for="Titulo" class="form-control border-0 shadow-none p-0 small fw-medium"
                           placeholder="Título del itinerario" />
                </div>
                <span asp-validation-for="Titulo" class="text-danger small mt-n2"></span>

                @* 2. Elige el destino (Acordeón pantalla 2 del mockup) *@
                <div class="border rounded-3 bg-white overflow-hidden">
                    <button type="button" class="btn w-100 d-flex align-items-center gap-2 px-3 py-2 text-start border-0 shadow-none"
                            data-bs-toggle="collapse" data-bs-target="#collapseDestino" aria-expanded="false">
                        <i class="bi bi-chevron-down small text-dark"></i>
                        <i class="bi bi-geo-alt fs-5 text-dark"></i>
                        <span id="label-destino" class="small text-secondary fw-medium">Elige el destino</span>
                    </button>
                    <div id="collapseDestino" class="collapse px-3 pb-3">
                        <input asp-for="DestinoNombre" id="input-destino" class="form-control form-control-sm mb-2"
                               placeholder="Nombre del destino (ej. Atenas, Grecia)" />
                        <div class="border rounded d-flex flex-column align-items-center justify-content-center bg-light text-muted position-relative"
                             style="height: 150px; border-color: #94a3b8 !important;">
                            <i class="bi bi-map fs-2 mb-1"></i>
                            <span id="mapa-preview-text" class="small">Vista previa del mapa del destino</span>
                        </div>
                    </div>
                </div>

                @* 3. Elige las fechas (Acordeón pantalla 3 del mockup) *@
                <div class="border rounded-3 bg-white overflow-hidden">
                    <button type="button" class="btn w-100 d-flex align-items-center gap-2 px-3 py-2 text-start border-0 shadow-none"
                            data-bs-toggle="collapse" data-bs-target="#collapseFechas" aria-expanded="false">
                        <i class="bi bi-chevron-down small text-dark"></i>
                        <i class="bi bi-calendar-event fs-5 text-dark"></i>
                        <span id="label-fechas" class="small text-secondary fw-medium">Elige las fechas</span>
                    </button>
                    <div id="collapseFechas" class="collapse px-3 pb-3">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label asp-for="FechaInicio" class="form-label small text-muted mb-1">De:</label>
                                <input asp-for="FechaInicio" id="input-fecha-inicio" type="date" class="form-control form-control-sm" />
                                <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="FechaFin" class="form-label small text-muted mb-1">Hasta:</label>
                                <input asp-for="FechaFin" id="input-fecha-fin" type="date" class="form-control form-control-sm" />
                                <span asp-validation-for="FechaFin" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="border rounded p-2 bg-light" style="border-color: #cbd5e1 !important;">
                            <div id="cal-mes-titulo" class="text-center fw-semibold small mb-1 text-dark"></div>
                            <div class="d-grid text-center small fw-bold text-muted mb-1" style="grid-template-columns: repeat(7, 1fr);">
                                <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                            </div>
                            <div id="cal-grid" class="d-grid text-center small" style="grid-template-columns: repeat(7, 1fr); gap: 2px;"></div>
                        </div>
                    </div>
                </div>

                @* 4. Presupuesto total (Acordeón pantalla 4 del mockup) *@
                <div class="border rounded-3 bg-white overflow-hidden">
                    <button type="button" class="btn w-100 d-flex align-items-center gap-2 px-3 py-2 text-start border-0 shadow-none"
                            data-bs-toggle="collapse" data-bs-target="#collapsePresupuesto" aria-expanded="false">
                        <i class="bi bi-chevron-down small text-dark"></i>
                        <i class="bi bi-cash-stack fs-5 text-dark"></i>
                        <span id="label-presupuesto" class="small text-secondary fw-medium">Presupuesto total</span>
                    </button>
                    <div id="collapsePresupuesto" class="collapse px-3 pb-3">
                        <label asp-for="Presupuesto" class="form-label small text-muted mb-1">Presupuesto calculado</label>
                        <div class="d-flex align-items-center gap-2">
                            <input asp-for="Presupuesto" id="input-presupuesto" type="text" inputmode="decimal"
                                   asp-format="{0:G}" data-haria-number="true"
                                   data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator"
                                   class="form-control form-control-sm text-center fw-semibold" placeholder="0" />
                            <span class="border rounded-circle d-inline-flex align-items-center justify-content-center fw-bold text-dark"
                                  style="width: 30px; height: 30px; flex-shrink: 0;">€</span>
                        </div>
                        <span asp-validation-for="Presupuesto" class="text-danger small"></span>
                    </div>
                </div>

                @* 5. Paradas / Actividades dinámicas *@
                <div class="border rounded-3 p-3 bg-white">
                    <div id="paradas-container" class="d-flex flex-column gap-3">
                        @for (int i = 0; i < Model.Paradas.Count; i++)
                        {
                            <div class="parada-card border-bottom pb-2">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                                        <i class="bi bi-bank fs-5 text-dark"></i>
                                        <input type="text" name="Paradas[@i].Nombre" value="@Model.Paradas[i].Nombre"
                                               class="form-control form-control-sm border-0 shadow-none px-1 fw-medium"
                                               placeholder="Nombre de parada / actividad" />
                                    </div>
                                    <button type="button" class="btn btn-link text-muted p-0 btn-del-parada" title="Eliminar parada">
                                        <i class="bi bi-x-lg small"></i>
                                    </button>
                                </div>

                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                    <select name="Paradas[@i].Dia" class="form-select form-select-sm py-0 px-2" style="width: auto; font-size: 0.78rem; border-radius: 6px;">
                                        <option value="1" selected>1º Día</option>
                                        <option value="2">2º Día</option>
                                        <option value="3">3º Día</option>
                                        <option value="4">4º Día</option>
                                        <option value="5">5º Día</option>
                                    </select>

                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 btn-toggle-extra"
                                            data-target="horario-@i" style="font-size: 0.78rem; border-radius: 6px;">
                                        <i class="bi bi-clock"></i> Horario
                                    </button>

                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 btn-toggle-extra"
                                            data-target="detalles-@i" style="font-size: 0.78rem; border-radius: 6px;">
                                        <i class="bi bi-pencil-square"></i> Detalles
                                    </button>
                                </div>

                                <div id="horario-@i" class="mt-2 d-none">
                                    <input type="time" name="Paradas[@i].Horario" value="@Model.Paradas[i].Horario"
                                           class="form-control form-control-sm" />
                                </div>
                                <div id="detalles-@i" class="mt-2 d-none">
                                    <input type="text" name="Paradas[@i].Detalles" value="@Model.Paradas[i].Detalles"
                                           class="form-control form-control-sm" placeholder="Notas, dirección o precio estimado..." />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-2">
                        <button type="button" id="btn-add-parada" class="btn btn-link text-muted text-decoration-none p-0 small">
                            <i class="bi bi-plus me-1"></i> Añadir parada / actividad
                        </button>
                    </div>
                </div>

                @* Campos originales de HARIA plegados para mantener el binding limpio *@
                <details class="small text-muted">
                    <summary>Opciones adicionales (Tipo, Estado, Carpetas, Collages)</summary>
                    <div class="pt-2 d-flex flex-column gap-2">
                        <div>
                            <label asp-for="TipoViaje" class="form-label mb-1"></label>
                            <select asp-for="TipoViaje" asp-items="Html.GetEnumSelectList<DSM_Odyss.Domain.Enums.TipoViaje>()" class="form-select form-select-sm"></select>
                            <span asp-validation-for="TipoViaje" class="text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="Estado" class="form-label mb-1"></label>
                            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<DSM_Odyss.Domain.Enums.EstadoViaje>()" class="form-select form-select-sm"></select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="CarpetasId" class="form-label mb-1"></label>
                            <select asp-for="CarpetasId" asp-items="Model.CarpetasOptions" class="form-select form-select-sm"><option value="">Selecciona...</option></select>
                            <span asp-validation-for="CarpetasId" class="text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="CollagesId" class="form-label mb-1"></label>
                            <select asp-for="CollagesId" asp-items="Model.CollagesOptions" class="form-select form-select-sm"><option value="">Selecciona...</option></select>
                            <span asp-validation-for="CollagesId" class="text-danger"></span>
                        </div>
                    </div>
                </details>

                @* 6. Switch Itinerario público *@
                <div class="d-flex align-items-center justify-content-between pt-1">
                    <div>
                        <label asp-for="EsPublico" class="fw-semibold small text-dark mb-0">Itinerario público</label>
                        <div class="text-muted" style="font-size: 0.72rem;">Tu itinerario será visible para el resto de la plataforma</div>
                    </div>
                    <div class="form-check form-switch m-0">
                        <input asp-for="EsPublico" class="form-check-input" type="checkbox" role="switch"
                               style="width: 2.5em; height: 1.3em;" />
                    </div>
                </div>

            </div>
        </div>

        @* Botones inferiores: Cancelar y Crear *@
        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Index" class="btn btn-outline-dark btn-sm px-4 py-1" style="border-radius: 6px;">Cancelar</a>
            <button type="submit" class="btn btn-secondary btn-sm px-4 py-1 fw-medium"
                    style="background-color: #cbd5e1; border-color: #64748b; color: #1e293b; border-radius: 6px;">
                Crear
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputDestino = document.getElementById("input-destino");
            const labelDestino = document.getElementById("label-destino");
            const mapaPreview = document.getElementById("mapa-preview-text");

            inputDestino?.addEventListener("input", function () {
                const val = this.value.trim();
                labelDestino.textContent = val || "Elige el destino";
                mapaPreview.textContent = val ? `Ubicación: ${val}` : "Vista previa del mapa del destino";
            });

            const inputPresupuesto = document.getElementById("input-presupuesto");
            const labelPresupuesto = document.getElementById("label-presupuesto");

            inputPresupuesto?.addEventListener("input", function () {
                const val = parseFloat(this.value.replace(",", "."));
                labelPresupuesto.textContent = !isNaN(val) && val > 0
                    ? `Presupuesto: ${val.toFixed(2)} €`
                    : "Presupuesto total";
            });

            const fInicio = document.getElementById("input-fecha-inicio");
            const fFin = document.getElementById("input-fecha-fin");
            const labelFechas = document.getElementById("label-fechas");
            const calGrid = document.getElementById("cal-grid");
            const calTitulo = document.getElementById("cal-mes-titulo");

            function renderCalendario() {
                if (!fInicio.value) return;
                const d1 = new Date(fInicio.value + "T00:00:00");
                const d2 = fFin.value ? new Date(fFin.value + "T00:00:00") : d1;

                const fmt = (d) => d.toLocaleDateString("es-ES");
                labelFechas.textContent = fFin.value
                    ? `De: ${fmt(d1)} - Hasta: ${fmt(d2)}`
                    : `De: ${fmt(d1)}`;

                const year = d1.getFullYear();
                const month = d1.getMonth();
                const meses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
                calTitulo.textContent = `${meses[month]} ${year}`;

                calGrid.innerHTML = "";
                const firstDay = new Date(year, month, 1).getDay();
                const offset = firstDay === 0 ? 6 : firstDay - 1;
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                for (let i = 0; i < offset; i++) calGrid.appendChild(document.createElement("span"));
                for (let day = 1; day <= daysInMonth; day++) {
                    const current = new Date(year, month, day);
                    const cell = document.createElement("span");
                    cell.textContent = day;
                    cell.className = "py-1 rounded";
                    if (current >= d1 && current <= d2) {
                        cell.style.backgroundColor = "#cbd5e1";
                        cell.classList.add("fw-bold", "text-dark");
                    }
                    calGrid.appendChild(cell);
                }
            }

            fInicio?.addEventListener("change", renderCalendario);
            fFin?.addEventListener("change", renderCalendario);
            renderCalendario();

            const paradasContainer = document.getElementById("paradas-container");
            const btnAddParada = document.getElementById("btn-add-parada");

            paradasContainer?.addEventListener("click", function (e) {
                const toggleBtn = e.target.closest(".btn-toggle-extra");
                if (toggleBtn) {
                    document.getElementById(toggleBtn.dataset.target)?.classList.toggle("d-none");
                }
                const delBtn = e.target.closest(".btn-del-parada");
                if (delBtn) {
                    delBtn.closest(".parada-card").remove();
                    paradasContainer.querySelectorAll(".parada-card").forEach((card, idx) => {
                        card.querySelector("input[name*='.Nombre']").name = `Paradas[${idx}].Nombre`;
                        card.querySelector("select[name*='.Dia']").name = `Paradas[${idx}].Dia`;
                        card.querySelector("input[name*='.Horario']").name = `Paradas[${idx}].Horario`;
                        card.querySelector("input[name*='.Detalles']").name = `Paradas[${idx}].Detalles`;
                    });
                }
            });

            btnAddParada?.addEventListener("click", function () {
                const idx = paradasContainer.querySelectorAll(".parada-card").length;
                const card = document.createElement("div");
                card.className = "parada-card border-bottom pb-2";
                card.innerHTML = `
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <i class="bi bi-bank fs-5 text-dark"></i>
                            <input type="text" name="Paradas[${idx}].Nombre"
                                   class="form-control form-control-sm border-0 shadow-none px-1 fw-medium"
                                   placeholder="Nombre de parada / actividad" />
                        </div>
                        <button type="button" class="btn btn-link text-muted p-0 btn-del-parada" title="Eliminar parada">
                            <i class="bi bi-x-lg small"></i>
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-1 flex-wrap">
                        <select name="Paradas[${idx}].Dia" class="form-select form-select-sm py-0 px-2" style="width: auto; font-size: 0.78rem; border-radius: 6px;">
                            <option value="1">1º Día</option>
                            <option value="2">2º Día</option>
                            <option value="3">3º Día</option>
                            <option value="4">4º Día</option>
                            <option value="5">5º Día</option>
                        </select>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 btn-toggle-extra"
                                data-target="horario-${idx}" style="font-size: 0.78rem; border-radius: 6px;">
                            <i class="bi bi-clock"></i> Horario
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 btn-toggle-extra"
                                data-target="detalles-${idx}" style="font-size: 0.78rem; border-radius: 6px;">
                            <i class="bi bi-pencil-square"></i> Detalles
                        </button>
                    </div>
                    <div id="horario-${idx}" class="mt-2 d-none">
                        <input type="time" name="Paradas[${idx}].Horario" class="form-control form-control-sm" />
                    </div>
                    <div id="detalles-${idx}" class="mt-2 d-none">
                        <input type="text" name="Paradas[${idx}].Detalles" class="form-control form-control-sm" placeholder="Notas, dirección o precio estimado..." />
                    </div>
                `;
                paradasContainer.appendChild(card);
                card.querySelector("input[name*='.Nombre']").focus();
            });
        });
    </script>
}