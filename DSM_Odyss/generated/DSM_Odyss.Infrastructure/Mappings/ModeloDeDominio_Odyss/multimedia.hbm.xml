<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DSM_Odyss.Domain"
                   namespace="DSM_Odyss.Domain.Entities">
  <class name="Multimedia" table="Multimedia">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Tipo" type="DSM_Odyss.Domain.Enums.TipoMultimedia, DSM_Odyss.Domain">
      <column name="tipo" not-null="true"/>
    </property>
    <property name="Nombre" type="String">
      <column name="nombre" not-null="true"/>
    </property>
    <property name="FechaSubida" type="Date">
      <column name="fechaSubida" sql-type="date" not-null="true"/>
    </property>
    <property name="Descripcion" type="String">
      <column name="descripcion" not-null="true"/>
    </property>
  </class>
  <query name="MultimediaReadAllHQL">from Multimedia</query>
</hibernate-mapping>
