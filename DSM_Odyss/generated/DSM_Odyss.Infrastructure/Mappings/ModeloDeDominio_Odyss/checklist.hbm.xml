<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DSM_Odyss.Domain"
                   namespace="DSM_Odyss.Domain.Entities">
  <class name="Checklist" table="Checklist">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Nombre" type="String">
      <column name="nombre" not-null="true"/>
    </property>
    <bag name="Checklist">
      <key>
        <column name="FK_Checklist_checklist"/>
      </key>
      <one-to-many class="Cliente"/>
    </bag>
    <bag name="Tareas">
      <key>
        <column name="FK_Checklist_tareas"/>
      </key>
      <one-to-many class="Tarea"/>
    </bag>
  </class>
  <query name="ChecklistReadAllHQL">from Checklist</query>
</hibernate-mapping>
