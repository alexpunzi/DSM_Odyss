<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DSM_Odyss.Domain"
                   namespace="DSM_Odyss.Domain.Entities">
  <class name="Tarea" table="Tarea">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Descripcion" type="String">
      <column name="descripcion" not-null="true"/>
    </property>
    <property name="Completada" type="Boolean">
      <column name="completada" not-null="true"/>
    </property>
  </class>
  <query name="TareaReadAllHQL">from Tarea</query>
</hibernate-mapping>
