<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DSM_Odyss.Domain"
                   namespace="DSM_Odyss.Domain.Entities">
  <class name="Estadisticas" table="Estadisticas">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Anyo" type="Int32">
      <column name="anyo"/>
    </property>
    <property name="PaisesVisitados" type="Int32">
      <column name="paisesVisitados"/>
    </property>
    <property name="FotosSubidas" type="Int32">
      <column name="fotosSubidas"/>
    </property>
    <property name="DestinoMasVisitado" type="String">
      <column name="destinoMasVisitado"/>
    </property>
  </class>
  <query name="EstadisticasReadAllHQL">from Estadisticas</query>
</hibernate-mapping>
