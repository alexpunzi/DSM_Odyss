<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DSM_Odyss.Domain"
                   namespace="DSM_Odyss.Domain.Entities">
  <class name="ParadaActividad" table="ParadaActividad">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Nombre" type="String">
      <column name="nombre" not-null="true"/>
    </property>
    <property name="Dia" type="Int32">
      <column name="dia" not-null="true"/>
    </property>
    <property name="Horario" type="Time">
      <column name="horario" sql-type="datetime2" not-null="true"/>
    </property>
    <property name="Detalles" type="String">
      <column name="detalles"/>
    </property>
    <property name="Completada" type="Boolean">
      <column name="completada" not-null="true"/>
    </property>
    <many-to-one name="Ubicacion" class="Ubicacion">
      <column name="FK_Ubicacion_ubicacion"/>
    </many-to-one>
  </class>
  <query name="ParadaActividadReadAllHQL">from ParadaActividad</query>
</hibernate-mapping>
