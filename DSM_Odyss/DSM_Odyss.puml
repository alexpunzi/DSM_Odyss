@startuml ModeloDeDominio_Odyss
skinparam packageStyle rectangle
title ModeloDeDominio_Odyss Domain

package "ModeloDeDominio_Odyss" {
  enum EstadoViaje {
    planificado
    enCurso
    finalizado
  }

  enum TipoMultimedia {
    foto
    video
  }

  enum TipoViaje {
    ocio
    trabajo
    familiar
    otro
  }

  enum CanalNotificacion {
    email
    sms
  }

  enum TipoAviso {
    notificacion
    alarma
  }

  class Cliente {
    -id: long <<oid>>
    -nombre: string
    -apellidos: string
    -email: string
    -pass: string <<password>>
    -fechaNacimiento: Date
    -canalNotificacion: CanalNotificacion
    -recibirRecordatorios: bool
  }

  class Viaje {
    -id: long <<oid>>
    -titulo: string
    -fechaInicio: Date
    -fechaFin: Date
    -esPublico: bool
    -presupuesto: float
    -tipoViaje: TipoViaje
    -estado: EstadoViaje
  }

  class Parada {
    -id: long <<oid>>
    -nombre: string
    -dia: int
    -horario: Time
    -detalles: string
    -completada: bool
  }

  class Carpeta {
    -id: long <<oid>>
    -nombre: string
    -anyo: int
  }

  class Multimedia {
    -id: long <<oid>>
    -nombre: string
    -fechaSubida: Date
    -descripcion: string
  }

  class Ubicacion {
    -id: long <<oid>>
    -nombre: string
    -ciudad: string
    -latitud: double
    -longitud: double
  }

  class Recordatorio {
    -id: long <<oid>>
    -titulo: string
    -detalles: string
    -fecha: Date
    -hora: Time
    -tipoAviso: TipoAviso
    -envidado: bool
  }

  ' Relationships
  Parada "parada\n0..*" --> "ubicacion\n0..1" Ubicacion
}
@enduml
