@startuml ModeloDeDominio_Odyss
skinparam packageStyle rectangle
title ModeloDeDominio_Odyss Domain

package "ModeloDeDominio_Odyss" {
  enum EstadoViaje {
    planificado
    enCurso
    finalizado
  }

  enum TipoMultimedia {
    foto
    video
  }

  enum TipoViaje {
    ocio
    trabajo
    familiar
    otro
  }

  enum CanalNotificacion {
    email
    sms
  }

  enum TipoAviso {
    notificacion
    alarma
  }

  class Cliente <<User>> {
    -id: long <<oid>> <<isToken>>
    -name: string
    -password: string <<password>>
    -nombre: string
    -apellidos: string
    -email: string
    -fechaNacimiento: Date
    -canalNotificacion: CanalNotificacion
    -recibirRecordatorios: bool
  }

  class ResumenAnual {
    -id: long <<oid>>
    -anyo: int
    -paisesVisitados: int
    -fotosSubidas: int
    -destinoMasVisitado: string
  }

  class Viaje {
    -id: long <<oid>>
    -titulo: string
    -fechaInicio: Date
    -fechaFin: Date
    -esPublico: bool
    -presupuesto: float
    -tipoViaje: TipoViaje
    -estado: EstadoViaje
  }

  class Parada {
    -id: long <<oid>>
    -nombre: string
    -dia: int
    -horario: Time
    -detalles: string
    -completada: bool
  }

  class Carpeta {
    -id: long <<oid>>
    -nombre: string
    -anyo: int
  }

  class Multimedia {
    -id: long <<oid>>
    -nombre: string
    -fechaSubida: Date
    -descripcion: string
  }

  class Collage {
    -id: long <<oid>>
    -urlImagen: string
    -fechaCreacion: Date
  }

  class Ubicacion {
    -id: long <<oid>>
    -nombre: string
    -ciudad: string
    -latitud: double
    -longitud: double
  }

  class Recordatorio {
    -id: long <<oid>>
    -titulo: string
    -detalles: string
    -fecha: Date
    -hora: Time
    -tipoAviso: TipoAviso
    -envidado: bool
  }

  class Checklist <<AggregateRoot>> {
    -id: long <<oid>>
    -nombre: string
  }

  class Tarea {
    -id: long <<oid>>
    -descripcion: string
    -completada: bool
  }

  ' Relationships
  Parada "parada\n0..*" --> "ubicacion\n0..1" Ubicacion
  Cliente "navigablecontactos\n0..*" --> "contactos\n0..*" Cliente
  Cliente "clienets\n1" --> "resumenes\n0..*" ResumenAnual
  Cliente "autor\n1" -- "viajes\n0..*" Viaje
  Viaje "c\n0..*" --> "compartidoCon\n0..*" Cliente
}
@enduml
